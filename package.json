{
  "name": "infra",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run ci:install && bun run ci:format && bun run check:agents && bun run check:llms && bun run check:scripts && bun run check:infra && turbo run tc lint test build test:site",
    "check:agents": "bun scripts/agent-commands.ts --check",
    "check:dev": "bun scripts/check-dev.ts",
    "check:llms": "bun scripts/llms-txt.ts --check",
    "check:vault-inputs": "bun scripts/vault-inputs-check.ts",
    "check:scripts": "tsc --noEmit -p tsconfig.json && bun test ./scripts",
    "check:ci": "bun run ci:install && bun scripts/check-ci.ts",
    "check:smoke:secrets": "vault run --config dev -- bun run --filter @pkgs/turborepo-remote-cache smoke:secrets",
    "check:vault-secrets": "vault run --config dev -- bun run --filter @pkgs/turborepo-remote-cache check:vault-secrets",
    "check:vault-secrets:prd": "vault run --config prd -- bun run --filter @pkgs/turborepo-remote-cache check:vault-secrets",
    "ci:format": "prettier --check . --cache --cache-strategy content --cache-location .cache/prettier",
    "ci:install": "bun install --frozen-lockfile",
    "deploy": "bun run infra:services apply",
    "dev": "VAULT_CONFIG=${VAULT_CONFIG:-dev} turbo run dev --ui=tui --env-mode=loose --continue=always",
    "format": "prettier --write .",
    "gh": "open https://github.com/crvouga/workspace/actions",
    "gh:ci": "open https://github.com/crvouga/workspace/actions/workflows/ci.yml",
    "gh:ci:log": "gh run view \"$(gh run list --workflow ci.yml --limit 1 --json databaseId --jq '.[0].databaseId')\" --log-failed",
    "gh:ci:status": "gh run list --workflow ci.yml --limit 3",
    "gh:ci:watch": "bun scripts/ci/watch.ts",
    "health": "bun run packages/infra/scripts/health.ts",
    "health:fix": "bun scripts/health-fix.ts",
    "domains": "bun run packages/infra/scripts/domains.ts",
    "migrate-domains-to-cloudflare": "bun run packages/infra/scripts/migrate-domains-to-cloudflare.ts",
    "health-check": "bun run --filter @pkgs/infra health-check",
    "list-deploy-service-ids": "bun run --filter @pkgs/infra list-deploy-service-ids",
    "list-publish-service-ids": "bun run --filter @pkgs/infra list-publish-service-ids",
    "print-platform-env": "bun run --filter @pkgs/infra print-platform-env",
    "print-publish-inputs": "bun run --filter @pkgs/infra print-publish-inputs",
    "infra": "tofu -chdir=packages/infra/tofu/foundation",
    "setup": "bun install --frozen-lockfile",
    "ws:install": "bun install --frozen-lockfile && bun run packages/workstation/cli/install-global.ts",
    "smoke": "vault run --config dev -- bun run --filter @pkgs/turborepo-remote-cache smoke",
    "smoke:prd": "vault run --config prd -- bun run --filter @pkgs/turborepo-remote-cache smoke",
    "tc": "turbo run tc",
    "typecheck": "tsc --noEmit",
    "vault:login": "vault login --method=userpass username=crvouga",
    "portfolio": "bun run --filter @pkgs/portfolio dev",
    "portfolio:build": "vault run --config dev -- bun run --filter @pkgs/portfolio build",
    "portfolio:gen": "bun run --filter @pkgs/portfolio gen",
    "agents:sync": "bun scripts/agent-commands.ts",
    "llms:sync": "bun scripts/llms-txt.ts",
    "pr:ready": "bun scripts/pr-ready.ts",
    "infra:services": "tofu -chdir=packages/infra/tofu/services",
    "vault:secrets": "bun scripts/vault-secrets-tfvars.ts",
    "vault:edit": "bun scripts/vault-edit.ts",
    "vault:fix": "bun scripts/vault-inputs-fix.ts",
    "infra:vault": "tofu -chdir=packages/infra/tofu/vault",
    "infra:bootstrap": "tofu -chdir=packages/infra/tofu/bootstrap",
    "infra:state": "tofu -chdir=packages/infra/tofu/state",
    "infra:signing": "tofu -chdir=packages/infra/tofu/signing",
    "check:infra": "bash packages/infra/tofu/check.sh",
    "infra:auth": "tofu -chdir=packages/infra/tofu/auth",
    "infra:auth-hosting": "tofu -chdir=packages/infra/tofu/auth-hosting",
    "auth:setup": "bun scripts/auth-setup.ts",
    "zoomies:configure": "vault run --config prd -- bun run --cwd packages/zoomies configure",
    "zoomies:join-token": "vault run --config prd -- bun run --cwd packages/zoomies join-token",
    "auth:test": "bun run --cwd packages/auth-relay test",
    "auth:test:e2e": "python3 -B packages/auth-relay/tests/run.py",
    "gh:deploy:status": "gh run list --workflow deploy.yml --limit 3",
    "gh:maintenance:status": "gh run list --workflow maintenance.yml --limit 3",
    "password-manager": "node packages/password-manager/bin.mjs",
    "password-manager:setup": "sh scripts/password-manager-setup.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@inquirer/prompts": "catalog:",
    "@opencode-ai/plugin": "1.18.29",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "bun-types": "catalog:",
    "chalk": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-lingui": "catalog:",
    "eslint-plugin-naming": "catalog:",
    "eslint-plugin-no-only-tests": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "ora": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.10.13",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "catalog": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@inquirer/prompts": "^8.5.2",
    "@types/bun": "^1.3.9",
    "@types/node": "^22.15.29",
    "chalk": "^6.0.0",
    "commander": "^14.0.2",
    "ora": "^8.2.0",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "aws4fetch": "^1.0.20",
    "bun-types": "^1.3.9",
    "eslint": "^9.25.0",
    "eslint-plugin-lingui": "^0.13.1",
    "eslint-plugin-naming": "^0.1.10",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hono": "^4.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.4",
    "turbo": "^2.9.16",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.1",
    "yaml": "^2.9.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2"
  }
}
