{
  "name": "@pkgs/turborepo-remote-cache",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "test -f Dockerfile",
    "check:vault-secrets": "bun run scripts/check-vault-secrets.ts",
    "lint": "eslint src --max-warnings 0",
    "setup": "bun run scripts/setup-dev-vars.ts",
    "smoke": "bun run scripts/smoke-test-cache.ts",
    "smoke:secrets": "bun run scripts/smoke-test-secrets.ts",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "dev:dormant": "bun ../../scripts/dev-server.ts remote-cache 8083 bun --env-file=.env run src/server.ts"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "@pkgs/object-store": "workspace:*",
    "@pkgs/secret-store": "workspace:*",
    "hono": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
