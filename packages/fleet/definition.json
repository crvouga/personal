{
  "$schema": "./definition.schema.json",
  "version": 3,
  "manager": {
    "id": "chriss-macbook-air",
    "os": "macOS",
    "network": {
      "tailscaleName": "chriss-macbook-air-1.tail4829dc.ts.net",
      "user": "chrisvouga"
    },
    "neverSleepOnPower": true
  },
  "workers": [
    {
      "id": "chris-vouga-ms-a2",
      "ssh": "chris-vouga-ms-a2",
      "os": "linux",
      "network": {
        "tailscaleName": "chris-vouga-ms-a2.tail4829dc.ts.net",
        "sshPort": 22,
        "user": "chris-vouga",
        "t3Port": 3773
      }
    },
    {
      "id": "chris-vouga-mac-studio",
      "ssh": "chris-vouga-mac-studio",
      "os": "linux",
      "network": {
        "tailscaleName": "chris-vouga-mac-studio.tail4829dc.ts.net",
        "sshPort": 22,
        "user": "chrisvouga",
        "t3Port": 3773
      }
    }
  ],
  "services": {
    "proxy": {
      "endpoint": "https://cli-proxy.chrisvouga.dev"
    },
    "monitoring": {
      "hubPort": 8443
    }
  },
  "ubuntu": {
    "release": "26.04",
    "architectures": ["amd64", "arm64"]
  },
  "worker": {
    "requiredCapabilities": [
      "github",
      "vault",
      "t3",
      "toolchain",
      "workstation",
      "worker"
    ],
    "githubLogin": "crvouga",
    "vaultUser": "crvouga",
    "toolchain": "mise.lock",
    "agentProfile": "proxy",
    "unattendedSudo": true,
    "persistentT3": true,
    "neverSleep": true
  }
}
