{
  "name": "@pkgs/fleet-api",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "build": "bun run build:css && test -f Dockerfile && test -f schema.hcl",
    "build:css": "tailwindcss -i src/ui/app.css -o dist/app.css --minify",
    "dev": "bun run build:css && bun ../../scripts/dev-server.ts fleet-api 8082 bun src/dev.ts",
    "dev:server": "bun run dev",
    "lint": "eslint src test playwright.config.ts --max-warnings 0",
    "tc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./test && bun run test:bdd",
    "demo": "bun run scripts/demo.ts",
    "test:bdd": "bddgen && playwright test",
    "dev:fixtures": "FLEET_DEV_MODE=fixtures bun run dev"
  },
  "dependencies": {
    "@pkgs/assert": "workspace:*",
    "@pkgs/logger": "workspace:*",
    "hono": "catalog:",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "catalog:",
    "@types/bun": "catalog:",
    "playwright-bdd": "9.2.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
