FROM quay.io/keycloak/keycloak:26.8.1@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244 AS build
# Production runs one replica with a local cache; the compatibility suite builds
# the clustered variant with --build-arg KC_CACHE=ispn to exercise two replicas.
ARG KC_CACHE=local
ENV KC_DB=postgres KC_CACHE=${KC_CACHE} KC_CACHE_STACK=jdbc-ping KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true \
    KC_HTTP_MANAGEMENT_HEALTH_ENABLED=false KC_TRANSACTION_XA_ENABLED=false
RUN /opt/keycloak/bin/kc.sh build
FROM quay.io/keycloak/keycloak:26.8.1@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244
COPY --from=build /opt/keycloak/ /opt/keycloak/
ARG KC_CACHE=local
# One replica with a local cache: Railway replicas cannot form a JGroups cluster
# (JDBC_PING joins time out and the node is declared split-brain, failing
# readiness), and the shared PlanetScale cluster has few connection slots, so a
# small pool and no clustering keep every instance within them.
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true \
    KC_HTTP_ENABLED=true KC_HTTP_PORT=8080 KC_HTTP_MANAGEMENT_HEALTH_ENABLED=false \
    KC_CACHE=${KC_CACHE} KC_CACHE_STACK=jdbc-ping KC_HTTP_MAX_QUEUED_REQUESTS=128 \
    KC_DB_POOL_INITIAL_SIZE=1 KC_DB_POOL_MIN_SIZE=1 KC_DB_POOL_MAX_SIZE=4 \
    KC_SHUTDOWN_DELAY=10s KC_TRANSACTION_XA_ENABLED=false
EXPOSE 8080 7800 57800
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080; printf "GET /health/live HTTP/1.0\r\n\r\n" >&3; head -1 <&3 | grep -q " 200 "'
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized"]
