# Managed by OpenTofu github_repository_file.
name: Publish image

on:
  push:
    branches:
      - ${branch}

permissions:
  contents: read
  packages: write
  id-token: write
  pull-requests: read

jobs:
%{ if branch == "master" && length([for service in services : service if service.id == "pickflix"]) > 0 ~}
  validate:
    uses: ./.github/workflows/check.yml

%{ endif ~}
%{ for service in services ~}
  ${service.job_name}:
%{ if service.id == "pickflix" ~}
    needs: validate
%{ endif ~}
    uses: ${infra_repo}/.github/workflows/ci.yml@main
    secrets:
      DEPLOY_DISPATCH_TOKEN: $${{ secrets.DEPLOY_DISPATCH_TOKEN }}
%{ if service.id == "pickflix" ~}
      # This existing GHCR package is owned by the workspace; the repository
      # GITHUB_TOKEN cannot write it. Use the managed cross-repository PAT.
      CALLER_GITHUB_TOKEN: $${{ secrets.DEPLOY_DISPATCH_TOKEN }}
%{ else ~}
      CALLER_GITHUB_TOKEN: $${{ github.token }}
%{ endif ~}
    with:
      service_id: ${service.id}
      dockerfile: ${service.dockerfile}
      context: ${service.build_context}
      image_owner: ${image_owner}
      image_prefix: ${image_prefix}
      infra_github_repo: ${infra_repo}

%{ endfor ~}
