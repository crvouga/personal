# Input for `bun run vault:secrets <this-file>` (copy to a *.env file first;
# *.env is gitignored). The same values are written to BOTH secret/personal/dev
# and secret/personal/prd, then reviewed and applied with `bun run infra:vault`.
#
# The map must be COMPLETE: any field already in Vault that is missing here is
# removed on apply. Export existing fields before adopting (see tofu/README.md).
# Never commit the filled-in file.
#
# Not listed because OpenTofu derives or generates them and overrides any value
# set here: TURBO_API, TURBO_TEAM, TURBO_CACHE, S3_ENDPOINT, S3_REGION,
# S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, VAULT_TOKEN, DATABASE_URL,
# CLOUDFLARE_ACCOUNT_ID, FLEET_*, PICKFLIX_*, MOVIEFINDER_AUTH_SECRET,
# AUTH_RELAY_*, AUTH_CONSOLE_*, AUTH_MANAGER_*.

# --- Google sign-in upstream for the auth relay (required)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- CI, portfolio and infrastructure tokens
PORTFOLIO_GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
RAILWAY_TOKEN=
OPENAI_API_KEY=
# Optional legacy CI aliases
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Publishing (required for prd)
DOCKER_USERNAME=
DOCKER_PASSWORD=

# --- Applications (required for prd)
MOCKINGBIRD_JUNCTION_API_KEY=
MOCKINGBIRD_STRIPE_SECRET_KEY=
YOUTUBE_API_KEY=
RESEND_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# --- Existing credentials to preserve while adopting, so clients keep working.
# Leave commented to let OpenTofu generate new ones.
# TURBO_TOKEN=
# 9ROUTER_PASSWORD=
# 9ROUTER_JWT_SECRET=
# 9ROUTER_API_KEY_SECRET=
# 9ROUTER_MACHINE_ID_SALT=
# 9ROUTER_TUNNEL_TOKEN is derived from the foundation root.
