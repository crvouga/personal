---
/**
 * `/projects/` and `/a/<id>/projects/`: every project, personal work and
 * employer products apart, each group ranked for the role's audience.
 */
import ProjectCard from '../components/ProjectCard.astro';
import GalleryDialog from '../components/GalleryDialog.astro';
import { ARCHIVE_PROJECTS } from '../content/project';
import { PROJECT_TOTALS, galleryFor } from '../lib/projects-view';
import type { RoleId } from '../roles/definitions';
import { presentationOf } from '../roles/presentation';

interface Props {
  /** Injected by stories; defaults to the page's presentation. */
  role?: RoleId;
}
const presentation = presentationOf(Astro);

// Personal work and employer products are listed apart, so nothing built for
// an employer reads as a side project. One flat gallery array spans both.
const personal = presentation.allProjects.filter((p) => p.setting === 'side');
const atWork = presentation.allProjects.filter((p) => p.setting === 'work');
const galleries = [...personal, ...atWork, ...ARCHIVE_PROJECTS].map(galleryFor);
const archiveOffset = personal.length + atWork.length;
---

<section class="container archive" aria-labelledby="projects-title">
  <a class="back" href={`${presentation.home}#projects`}>&#8592; Home</a>
  <header>
    <h1 id="projects-title">All projects</h1>
    <p class="lede">
      <span data-project-count={PROJECT_TOTALS.listed}>{PROJECT_TOTALS.listed} projects</span>,
      strongest evidence first for {presentation.audience.toLowerCase()}, plus {PROJECT_TOTALS.archived} early ones in the
      archive below. A{' '}
      <strong class="handwritten-text">Hand-written</strong>{' '}
      badge marks work from before AI coding agents, dated from each project's git history.
    </p>
  </header>
  <h2 class="group-title">Personal projects</h2>
  <div class="grid">
    {personal.map((project, index) => (
      <ProjectCard project={project} galleryIndex={index} role={presentation.id} />
    ))}
  </div>
  <h2 class="group-title">Products I built at work</h2>
  <p class="group-note">Employer code: the products are live or shown in screenshots, the source is not public.</p>
  <div class="grid">
    {atWork.map((project, index) => (
      <ProjectCard project={project} galleryIndex={personal.length + index} role={presentation.id} />
    ))}
  </div>
  {/* Early games, toys and client sites, folded below the work samples so
      they never compete with them, but still shown as full cards. */}
  <details class="everything">
    <summary>
      <span class="summary-label">Archive — {PROJECT_TOTALS.archived} early and small projects</span>
      <span class="summary-hint">games, toys, demos and client sites</span>
    </summary>
    <div class="grid">
      {ARCHIVE_PROJECTS.map((project, index) => (
        <ProjectCard project={project} galleryIndex={archiveOffset + index} />
      ))}
    </div>
  </details>
</section>
<GalleryDialog galleries={galleries} />


<style>
  .archive {
    padding-block: var(--space-7) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .back {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    align-self: flex-start;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(28px, 5vw, 44px);
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: var(--space-3);
    max-width: 68ch;
    color: var(--text-muted);
  }
  .group-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    margin-top: var(--space-4);
  }
  .group-note {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-top: calc(var(--space-4) * -1);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  .everything {
    border-top: 1px solid var(--paper-border);
    padding-top: var(--space-5);
  }
  .everything summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    min-height: var(--tap);
    padding: var(--space-2) 0;
    cursor: pointer;
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    color: var(--accent);
  }
  /* `display: flex` drops the native disclosure triangle, so the open/closed
     state gets an explicit caret. */
  .everything summary::marker,
  .everything summary::-webkit-details-marker {
    display: none;
    content: '';
  }
  .everything summary::before {
    content: '\25B8';
    color: var(--text-muted);
  }
  .everything[open] summary::before {
    content: '\25BE';
  }
  .everything summary:hover .summary-label {
    text-decoration: underline;
  }
  .summary-hint {
    color: var(--text-muted);
  }
  .everything[open] summary {
    margin-bottom: var(--space-5);
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
