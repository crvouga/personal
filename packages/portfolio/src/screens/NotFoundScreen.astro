---
/** The 404 page body. */
---

<section class="container notfound">
  <p class="code">404</p>
  <h1>That page does not exist.</h1>
  <p class="sub">It may have moved, or the link may be wrong. Try one of these:</p>
  <ul class="links">
    <li><a href="/">Home</a></li>
    <li><a href="/projects/">All projects</a></li>
  </ul>
</section>


<style>
  .notfound {
    padding-block: var(--space-9);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .code {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    color: var(--accent);
  }
  h1 {
    font-size: clamp(28px, 5vw, 44px);
    letter-spacing: -0.02em;
  }
  .sub {
    color: var(--text-muted);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--accent);
  }
  .links a:hover {
    color: var(--accent-hover);
  }
</style>
