---
/** One post. */
import { render } from 'astro:content';
import { CONTENT } from '../content/content';
import type { Post } from '../lib/published-posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content } = await render(post.entry);
const date = post.data.date.toISOString().slice(0, 10);
---

<article class="container post" aria-labelledby="post-title">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">/</span>
    <a href="/writing/">Writing</a>
  </nav>
  <h1 id="post-title">{post.data.title}</h1>
  <p class="meta">{CONTENT.PAGE_TITLE} · <time datetime={date}>{date}</time></p>
  <div class="body"><Content /></div>
</article>


<style>
  .post {
    max-width: 720px;
    padding-block: var(--space-7) var(--space-8);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
  }
  h1 {
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.15;
  }
  .meta {
    margin-top: var(--space-3);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .body {
    margin-top: var(--space-6);
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .body :global(h2) {
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-top: var(--space-4);
  }
  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text);
  }
  .body :global(pre) {
    overflow-x: auto;
    padding: var(--space-4);
    background: var(--paper);
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-md);
  }
</style>
