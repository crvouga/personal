---
/** `/writing/`: published posts, newest first. */
import { postHref, type Post } from '../lib/published-posts';

interface Props {
  posts: readonly Post[];
}
const { posts } = Astro.props;
---

<section class="container writing" aria-labelledby="writing-title">
  <h1 id="writing-title">Writing</h1>
  <p class="lede"><a href="/rss.xml">RSS feed</a></p>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={postHref(post)}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {post.data.date.toISOString().slice(0, 10)}
        </time>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</section>


<style>
  .writing {
    max-width: 780px;
    padding-block: var(--space-7) var(--space-8);
  }
  .posts {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .posts a {
    font-family: var(--font-accent);
    font-size: var(--text-lg);
  }
  time {
    display: block;
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .posts p {
    color: var(--text-muted);
  }
</style>
