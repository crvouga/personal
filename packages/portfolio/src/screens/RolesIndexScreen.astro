---
/** `/roles/`: one line per role, each linking to its own page. */
import { ROLE_CARDS, LANDSCAPE_SUMMARY, percent } from '../roles/index-view';

const summary = LANDSCAPE_SUMMARY;
---

<section class="container index" aria-labelledby="roles-title">
  <header>
    <h1 id="roles-title">Roles</h1>
    <p class="lede">
      {ROLE_CARDS.length} presentations of this site, one per kind of job, ordered by
      opportunity. From the market landscape of {summary.date}.
    </p>
  </header>

  <ol class="list">
    {
      ROLE_CARDS.map((card) => (
        <li class="row">
          <a class="main" href={card.detailsHref}>
            <span class="rank">{card.rank}</span>
            <span class="text">
              <span class="name">
                {card.id}
                {card.isDefault && <span class="badge">Default</span>}
              </span>
              <span class="audience">{card.audience}</span>
            </span>
          </a>
          <a class="open" href={card.href} aria-label={`Open presentation: ${card.id}`} data-keep-href>
            Open ↗
          </a>
        </li>
      ))
    }
  </ol>

  <p class="footnote">
    {summary.eligible} in-scope postings of {summary.fetched} sampled
    ({summary.sources.map((source) => `${source.id} ${String(source.postings)}`).join(' · ')}).
    Asked for but not evidenced: {summary.gaps.map((gap) => `${gap.label} ${percent(gap.share)}`).join(', ')}.
  </p>
</section>


<style>
  .index {
    padding-block: var(--space-8);
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
  }
  .lede {
    max-width: 75ch;
    margin-top: var(--space-4);
    color: var(--text-muted);
  }
  .list {
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--paper-border);
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    border-bottom: 1px solid var(--paper-border);
  }
  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    color: inherit;
    text-decoration: none;
  }
  .main:hover .name {
    color: var(--accent);
  }
  .rank {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    color: var(--text-subtle);
    min-width: 2ch;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .name {
    font-family: var(--font-accent);
    font-weight: 600;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .badge {
    margin-left: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
  }
  .audience {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .open {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .footnote {
    max-width: 85ch;
    margin-top: var(--space-6);
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
</style>
