---
import { render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { CONTENT } from '../../content/content';
import { publishedPosts, type Post } from '../../lib/published-posts';
import { seoForPost } from '../../lib/seo';

export const getStaticPaths = async () =>
  (await publishedPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content } = await render(post.entry);
const seo = seoForPost({ slug: post.id, title: post.data.title, description: post.data.description });
const date = post.data.date.toISOString().slice(0, 10);
---

<Page seo={seo}>
  <article class="container post" aria-labelledby="post-title">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <a href="/writing/">Writing</a>
    </nav>
    <h1 id="post-title">{post.data.title}</h1>
    <p class="meta">{CONTENT.PAGE_TITLE} · <time datetime={date}>{date}</time></p>
    <div class="body"><Content /></div>
  </article>
</Page>

<style>
  .post {
    max-width: 720px;
    padding-block: var(--space-7) var(--space-8);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  h1 {
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.15;
  }
  .meta {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .body {
    margin-top: var(--space-6);
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .body :global(h2) {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    margin-top: var(--space-4);
  }
  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text);
  }
  .body :global(pre) {
    overflow-x: auto;
    padding: var(--space-4);
    background: var(--paper);
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-md);
  }
</style>
