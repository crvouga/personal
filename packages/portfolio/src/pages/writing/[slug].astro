---
import Page from '../../layouts/Page.astro';
import { publishedPosts, type Post } from '../../lib/published-posts';
import { seoForPost } from '../../lib/seo';
import WritingPostScreen from '../../screens/WritingPostScreen.astro';

export const getStaticPaths = async () =>
  (await publishedPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));

interface Props {
  post: Post;
}
const { post } = Astro.props;
const seo = seoForPost({ slug: post.id, title: post.data.title, description: post.data.description });
---

<Page seo={seo}>
  <WritingPostScreen post={post} />
</Page>
