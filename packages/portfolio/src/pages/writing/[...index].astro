---
import Page from '../../layouts/Page.astro';
import { CONTENT } from '../../content/content';
import { publishedPosts } from '../../lib/published-posts';
import { seoForIndex } from '../../lib/seo';
import WritingIndexScreen from '../../screens/WritingIndexScreen.astro';

// `/writing/` exists only once a post is published: an empty index would be
// a page that promises writing and has none.
export const getStaticPaths = async () =>
  (await publishedPosts()).length > 0 ? [{ params: { index: undefined } }] : [];

const posts = await publishedPosts();
const seo = seoForIndex({
  title: `Writing — ${CONTENT.PAGE_TITLE}`,
  description: 'Notes on verifying software written with AI coding agents, from the repositories they describe.',
  path: '/writing/',
});
---

<Page seo={seo}>
  <WritingIndexScreen posts={posts} />
</Page>
