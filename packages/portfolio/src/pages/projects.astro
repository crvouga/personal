---
import Page from '../layouts/Page.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GalleryDialog from '../components/GalleryDialog.astro';
import { CONTENT } from '../content/content';
import { ARCHIVE_PROJECTS } from '../content/project';
import {
  LISTED_PROJECTS,
  PROJECT_TOTALS,
  galleryFor,
  projectHref,
} from '../lib/projects-view';
import { seoForIndex } from '../lib/seo';

// Personal work and employer products are listed apart, so nothing built for
// an employer reads as a side project. One flat gallery array spans both.
const personal = LISTED_PROJECTS.filter((p) => p.setting === 'side');
const atWork = LISTED_PROJECTS.filter((p) => p.setting === 'work');
const galleries = [...personal, ...atWork].map(galleryFor);

const seo = seoForIndex({
  title: `All projects — ${CONTENT.PAGE_TITLE}`,
  description: `${String(PROJECT_TOTALS.listed)} projects: production platforms in education and health, developer tools, and the infrastructure behind them.`,
  path: '/projects/',
});
---

<Page seo={seo}>
  <section class="container archive" aria-labelledby="projects-title">
    <a class="back" href="/#projects">&#8592; Home</a>
    <header>
      <h1 id="projects-title">All projects</h1>
      <p class="lede">
        <span data-project-count={PROJECT_TOTALS.listed}>{PROJECT_TOTALS.listed} projects</span>,
        in the order I would show them, plus {PROJECT_TOTALS.archived} early ones in the
        archive below. A{' '}
        <strong class="handwritten-text">Hand-written</strong>{' '}
        footer marks work from before AI coding agents, dated from each project's git history.
      </p>
    </header>
    <h2 class="group-title">Personal projects</h2>
    <div class="grid">
      {personal.map((project, index) => (
        <ProjectCard project={project} galleryIndex={index} />
      ))}
    </div>
    <h2 class="group-title">Products I built at work</h2>
    <p class="group-note">Employer code: the products are live or shown in screenshots, the source is not public.</p>
    <div class="grid">
      {atWork.map((project, index) => (
        <ProjectCard project={project} galleryIndex={personal.length + index} />
      ))}
    </div>
    {/* Early games, toys and client sites: one line each, folded. Kept so an
        old project is still one click away; not shown as work samples. */}
    <details class="everything">
      <summary>
        <span class="summary-label">Archive — {PROJECT_TOTALS.archived} early and small projects</span>
        <span class="summary-hint">games, toys, demos and client sites</span>
      </summary>
      <ul class="archive-list">
        {ARCHIVE_PROJECTS.map((project) => {
          const href = projectHref(project);
          return (
            <li>
              {href === null ? (
                <span class="archive-title">{project.title}</span>
              ) : (
                <a class="archive-title" href={href} rel="noopener" target="_blank">
                  {project.title}
                </a>
              )}
              <span class="archive-desc">{project.description}</span>
            </li>
          );
        })}
      </ul>
    </details>
  </section>
  <GalleryDialog galleries={galleries} />
</Page>

<style>
  .archive {
    padding-block: var(--space-7) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .back {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    align-self: flex-start;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(28px, 5vw, 44px);
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: var(--space-3);
    max-width: 68ch;
    color: var(--text-muted);
  }
  .group-title {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    margin-top: var(--space-4);
  }
  .group-note {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-top: calc(var(--space-4) * -1);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  .everything {
    border-top: 1px solid var(--paper-border);
    padding-top: var(--space-5);
  }
  .everything summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    min-height: var(--tap);
    padding: var(--space-2) 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
  }
  /* `display: flex` drops the native disclosure triangle, so the open/closed
     state gets an explicit caret. */
  .everything summary::marker,
  .everything summary::-webkit-details-marker {
    display: none;
    content: '';
  }
  .everything summary::before {
    content: '\25B8';
    color: var(--text-muted);
  }
  .everything[open] summary::before {
    content: '\25BE';
  }
  .everything summary:hover .summary-label {
    text-decoration: underline;
  }
  .summary-hint {
    color: var(--text-muted);
  }
  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .archive-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
    border-top: 1px solid var(--paper-border);
  }
  .archive-title {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .archive-desc {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .everything[open] summary {
    margin-bottom: var(--space-5);
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
