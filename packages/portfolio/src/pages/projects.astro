---
import Page from '../layouts/Page.astro';
import ProjectsScreen from '../screens/ProjectsScreen.astro';
import { CONTENT } from '../content/content';
import { PROJECT_TOTALS } from '../lib/projects-view';
import { seoForIndex } from '../lib/seo';

const seo = seoForIndex({
  title: `All projects — ${CONTENT.PAGE_TITLE}`,
  description: `${String(PROJECT_TOTALS.listed)} projects: production platforms in education and health, developer tools, and the infrastructure behind them.`,
  path: '/projects/',
});
---

<Page seo={seo}>
  <ProjectsScreen />
</Page>
