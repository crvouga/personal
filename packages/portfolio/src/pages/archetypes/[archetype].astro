---
/**
 * One archetype's own page in Chris's index. Not for visitors: unlinked,
 * `noindex`, and left out of the sitemap.
 */
import { ARCHETYPE_CARDS, type ArchetypeCard } from '../../archetypes/index-view';
import { CONTENT } from '../../content/content';
import Page from '../../layouts/Page.astro';
import { DEFAULT_OG_IMAGE } from '../../lib/seo';
import type { Seo } from '../../lib/seo-types';
import ArchetypeDetailScreen from '../../screens/ArchetypeDetailScreen.astro';

export const getStaticPaths = () =>
  ARCHETYPE_CARDS.map((card) => ({
    params: { archetype: card.id },
    props: { card },
  }));

interface Props {
  card: ArchetypeCard;
}
const { card } = Astro.props;

const seo: Seo = {
  title: `${card.id} — Archetypes — ${CONTENT.PAGE_TITLE}`,
  description: card.audience,
  path: card.detailsHref,
  image: DEFAULT_OG_IMAGE,
  schema: { t: 'none' },
  noindex: true,
};
---

<Page seo={seo}>
  <ArchetypeDetailScreen subject={card.id} />
</Page>
