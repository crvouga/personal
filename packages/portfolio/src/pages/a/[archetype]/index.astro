---
import {
  VARIANT_PRESENTATIONS,
  type Presentation,
} from '../../../archetypes/presentation';
import Home from '../../../components/Home.astro';

/**
 * One homepage per non-default archetype, at `/a/<id>/`: a plain static
 * page, so any static host serves it. Old `/?archetype=<id>` links redirect
 * here (nginx.conf, and a script on `/` for hosts that ignore the query).
 */
export const getStaticPaths = () =>
  VARIANT_PRESENTATIONS.map((presentation) => ({
    params: { archetype: presentation.id },
    props: { presentation },
  }));

interface Props {
  presentation: Presentation;
}
Astro.locals.presentation = Astro.props.presentation;
---

<Home />
