---
/**
 * One role's own page in Chris's index. Not for visitors: unlinked,
 * `noindex`, and left out of the sitemap.
 */
import { ROLE_CARDS, type RoleCard } from '../../roles/index-view';
import { CONTENT } from '../../content/content';
import Page from '../../layouts/Page.astro';
import { DEFAULT_OG_IMAGE } from '../../lib/seo';
import type { Seo } from '../../lib/seo-types';
import RoleDetailScreen from '../../screens/RoleDetailScreen.astro';

export const getStaticPaths = () =>
  ROLE_CARDS.map((card) => ({
    params: { role: card.id },
    props: { card },
  }));

interface Props {
  card: RoleCard;
}
const { card } = Astro.props;

const seo: Seo = {
  title: `${card.id} — Roles — ${CONTENT.PAGE_TITLE}`,
  description: card.audience,
  path: card.detailsHref,
  image: DEFAULT_OG_IMAGE,
  schema: { t: 'none' },
  noindex: true,
};
---

<Page seo={seo}>
  <RoleDetailScreen subject={card.id} />
</Page>
