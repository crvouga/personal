---
/**
 * Chris's own index of the presentations. Not for visitors: unlinked,
 * `noindex`, and left out of the sitemap.
 */
import { CONTENT } from '../../content/content';
import Page from '../../layouts/Page.astro';
import { DEFAULT_OG_IMAGE } from '../../lib/seo';
import type { Seo } from '../../lib/seo-types';
import RolesIndexScreen from '../../screens/RolesIndexScreen.astro';

const seo: Seo = {
  title: `Roles — ${CONTENT.PAGE_TITLE}`,
  description:
    'The job roles this portfolio is presented for, with the market data behind each.',
  path: '/roles/',
  image: DEFAULT_OG_IMAGE,
  schema: { t: 'none' },
  noindex: true,
};
---

<Page seo={seo}>
  <RolesIndexScreen />
</Page>
