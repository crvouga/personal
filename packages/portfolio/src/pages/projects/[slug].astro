---
import Page from '../../layouts/Page.astro';
import CaseStudyScreen from '../../screens/CaseStudyScreen.astro';
import { CASE_STUDIES, type CaseStudy } from '../../content/case-studies';
import { PROJECTS } from '../../content/project';
import { seoForCaseStudy } from '../../lib/seo';

export const getStaticPaths = () =>
  CASE_STUDIES.map((study) => ({ params: { slug: study.slug }, props: { study } }));

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const project = PROJECTS.find((p) => p.id === study.projectId);
const codeUrl = project?.code.t === 'public' ? project.code.url : undefined;
const seo = seoForCaseStudy(study, codeUrl);
---

<Page seo={seo}>
  <CaseStudyScreen slug={study.slug} />
</Page>
