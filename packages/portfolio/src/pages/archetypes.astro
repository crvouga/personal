---
/**
 * Chris's own index of the presentations: each archetype, what it is, the
 * market numbers that justify it, and a link to open it. Not for visitors:
 * it is unlinked, `noindex`, and left out of the sitemap.
 */
import {
  ARCHETYPE_CARDS,
  LANDSCAPE_SUMMARY,
  percent,
} from '../archetypes/index-view';
import { CONTENT } from '../content/content';
import Page from '../layouts/Page.astro';
import { DEFAULT_OG_IMAGE } from '../lib/seo';
import type { Seo } from '../lib/seo-types';

const seo: Seo = {
  title: `Archetypes — ${CONTENT.PAGE_TITLE}`,
  description:
    'The job archetypes this portfolio is presented for, with the market data behind each.',
  path: '/archetypes/',
  image: DEFAULT_OG_IMAGE,
  schema: { t: 'none' },
  noindex: true,
};

const summary = LANDSCAPE_SUMMARY;
// An SVG attribute, not a style attribute: the CSP allows no inline styles.
const width = (share: number): string => `${String(Math.round(share * 100))}%`;
---

<Page seo={seo}>
  <section class="container index" aria-labelledby="archetypes-title">
    <header>
      <h1 id="archetypes-title">Archetypes</h1>
      <p class="lede">
        {ARCHETYPE_CARDS.length} presentations of this site, one per kind of job. Each is a set
        of segments in the market landscape of {summary.date}: {summary.eligible} in-scope
        postings out of {summary.fetched} sampled ({summary.needsClearance} need a security
        clearance, {summary.outOfScope} are other roles, levels or countries). Ordered by
        opportunity: skill fit × √share.
      </p>
      <p class="sources">
        Sources: {summary.sources.map((source) => `${source.id} ${String(source.postings)}`).join(' · ')}
      </p>
    </header>

    <div class="cards">
      {
        ARCHETYPE_CARDS.map((card) => (
          <article class="card archetype" id={card.id}>
            <div class="head">
              <h2>{card.id}</h2>
              {card.isDefault && <span class="badge">Default</span>}
            </div>
            <p class="audience">{card.audience}</p>
            <p class="description">{card.description}</p>
            <p class="why">
              <span class="label">Why it exists</span>
              {card.justification}
            </p>

            <dl class="stats">
              {card.stats.map((stat) => (
                <div class="stat">
                  <dt>{stat.label}</dt>
                  <dd>{stat.value}</dd>
                </div>
              ))}
            </dl>

            <div class="columns">
              <div>
                <h3>What its postings ask for</h3>
                <ul class="bars">
                  {card.themes.map((bar) => (
                    <li>
                      <span class="bar-label">{bar.label}</span>
                      <span class="bar-value">
                        {percent(bar.share)} · {bar.lift.toFixed(1)}×
                      </span>
                      <svg class="track" aria-hidden="true" focusable="false">
                        <rect class="fill" width={width(bar.share)} height="100%" />
                      </svg>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h3>Skills they name</h3>
                <ul class="bars">
                  {card.skills.map((bar) => (
                    <li class:list={{ gap: !bar.have }}>
                      <span class="bar-label">
                        {bar.label}
                        {!bar.have && <span class="gap-mark"> · no evidence</span>}
                      </span>
                      <span class="bar-value">{percent(bar.share)}</span>
                      <svg class="track" aria-hidden="true" focusable="false">
                        <rect class="fill" width={width(bar.share)} height="100%" />
                      </svg>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <p class="pitch">
              <span class="label">Leads with</span>
              “{card.statement}” <span class="availability">{card.availability}</span>
            </p>

            <p class="covers">
              Segments: {card.covers.join(' · ')}. Sample postings:{' '}
              {card.samples.map((sample, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={sample.url} rel="noopener noreferrer" target="_blank">
                    {sample.title} ({sample.company})
                  </a>
                </>
              ))}
            </p>

            <div class="actions">
              <a class="btn btn-contained" href={card.href} aria-label={`Open presentation: ${card.id}`} data-keep-href>
                <span class="btn-label">Open presentation</span>
              </a>
              <a class="action" href={card.resumeHref} target="_blank" rel="noopener" aria-label={`Résumé PDF: ${card.id}`}
                data-keep-href>
                Résumé PDF
              </a>
              <code class="url">{card.href}</code>
            </div>
          </article>
        ))
      }
    </div>

    <section class="gaps" aria-labelledby="gaps-title">
      <h2 id="gaps-title">Asked for, not evidenced</h2>
      <p class="lede">
        The most-requested skills across all in-scope postings that nothing in the knowledge
        base backs: {summary.gaps.map((gap) => `${gap.label} ${percent(gap.share)}`).join(', ')}.
      </p>
    </section>
  </section>
</Page>

<style>
  .index {
    padding-block: var(--space-8);
  }
  h1 {
    font-family: var(--font-mono);
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
  }
  .lede {
    max-width: 75ch;
    margin-top: var(--space-4);
    color: var(--text-muted);
  }
  .sources,
  .covers {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
  .sources {
    margin-top: var(--space-3);
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  .archetype {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    scroll-margin-top: 96px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  h2 {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
  }
  .audience {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
  }
  .description,
  .why,
  .pitch {
    max-width: 85ch;
    color: var(--text-muted);
  }
  .label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
  .pitch {
    color: var(--text);
  }
  .availability {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .stat {
    padding: var(--space-3);
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-md);
  }
  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
  dd {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text);
  }
  .columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  @media (min-width: 800px) {
    .columns {
      grid-template-columns: 1fr 1fr;
    }
  }
  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .bars {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .bars li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .bar-value {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
  .track {
    grid-column: 1 / -1;
    width: 100%;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--paper-border);
  }
  .fill {
    fill: var(--accent);
  }
  .gap .fill {
    fill: var(--text-subtle);
  }
  .gap-mark {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .url {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
    overflow-wrap: anywhere;
  }
  .gaps {
    margin-top: var(--space-8);
  }
</style>
