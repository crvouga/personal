---
import { CONTENT } from '../content/content';

const section = CONTENT.GET_SECTION('about');
const school = CONTENT.SCHOOL[0];
---

<section id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="section-heading">
      <span class="number" aria-hidden="true">{section.number}</span>
      <h2 id="about-title">{section.title}</h2>
    </div>
    <div class="prose">
      {CONTENT.ABOUT_ME_PARAGRAPHS.map((paragraph) => <p set:html={paragraph} />)}
    </div>
    {
      school !== undefined && (
        <p class="credential">
          <span class="credential-label">Education</span>
          <span>
            {school.degree} ·{' '}
            {school.infoUrl === undefined ? (
              school.institutionName
            ) : (
              <a class="inline-link" href={school.infoUrl} rel="noopener" target="_blank">
                {school.institutionName}
              </a>
            )}{' '}
            · {school.yearStart}–{school.yearEnd}
          </span>
        </p>
      )
    }
    <div class="toolbox">
      <h3 class="toolbox-title">Toolbox</h3>
      {
        CONTENT.TOOLBOX.primary.map((row) => (
          <div class="tool-row">
            <span class="tool-cat">{row.category}</span>
            <span class="tool-items">{row.items.join(' · ')}</span>
          </div>
        ))
      }
      {CONTENT.TOOLBOX.also.length > 0 && (
        <details class="also">
          <summary>Also shipped with ({CONTENT.TOOLBOX.also.length})</summary>
          <p class="tool-items">{CONTENT.TOOLBOX.also.join(' · ')}</p>
        </details>
      )}
    </div>
  </div>
</section>

<style>
  .prose {
    max-width: 68ch;
    color: var(--text-muted);
    font-size: var(--text-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  /* The degree is a line of text, not a photograph of a diploma. */
  .credential {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-base);
    color: var(--text-muted);
  }
  .credential-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-top: 2px;
  }
  .toolbox {
    margin-top: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .toolbox-title {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .tool-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: 1px solid var(--paper-border);
  }
  @media (min-width: 900px) {
    .tool-row {
      grid-template-columns: 140px 1fr;
      gap: var(--space-4);
      align-items: baseline;
    }
  }
  .tool-cat {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }
  .also {
    border-top: 1px solid var(--paper-border);
    padding-top: var(--space-2);
  }
  .also summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }
  .tool-items {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
