---
import { TOPIC_TO_IMAGE_SRC, TOPIC_TO_NAME } from '../content/topic';
import type { Project } from '../content/project';
import { caseStudyFor, caseStudyHref } from '../content/case-studies';
import { authorshipOf } from '../lib/authorship';
import { accessNote, galleryFor, projectHref } from '../lib/projects-view';

interface Props {
  project: Project;
  /** Index into the page's flat gallery array; null renders no Images button. */
  galleryIndex?: number | null;
  /** Archive rows: no cover, plain chips. */
  compact?: boolean;
  /** Homepage flagships: show the case study's one-line "why it matters". */
  featured?: boolean;
}
const {
  project,
  galleryIndex = null,
  compact = false,
  featured = false,
} = Astro.props;

const MAX_CHIPS = 6;
const study = caseStudyFor(project.id);
const studyHref = study === undefined ? null : caseStudyHref(study);
// The title leads to the fullest account: the case study when there is one.
const href = studyHref ?? projectHref(project);
const external = studyHref === null;
const note = accessNote(project);
const chips = project.topics.slice(0, MAX_CHIPS);
const extraTopics = Math.max(0, project.topics.length - MAX_CHIPS);
const cover = compact ? undefined : project.imageSrc[0];
const hasGallery = galleryIndex !== null && galleryFor(project).length > 0;
const badge = authorshipOf(project);
---

<article class:list={['card', 'project', { compact }]}>
  {
    !compact && (
      <div class="cover-box">
        {/* Always rendered, even with no screenshot: a card that omits the
            box is a different height and breaks the grid's alignment. */}
        {cover === undefined ? (
          <span class="cover-fallback" aria-hidden="true">
            {project.title}
          </span>
        ) : (
          <img
            class="cover"
            src={cover}
            alt={project.imageAlt}
            loading="lazy"
            decoding="async"
            width="1400"
            height="788"
          />
        )}
      </div>
    )
  }
  <div class="body">
    <div class="heading">
      <h3>
        {/* Client work under NDA has no destination but its gallery;
            an <a> without an href would read as a broken link. */}
        {
          href === null ? (
            project.title
          ) : (
            external ? (
              <a href={href} rel="noopener" target="_blank">
                {project.title}
              </a>
            ) : (
              <a href={href}>{project.title}</a>
            )
          )
        }
      </h3>
    </div>
    <p class="desc">{project.description}</p>
    {featured && study !== undefined && <p class="subline">{study.subline}</p>}
    <div class="meta">
      <div class="chips">
        {
          chips.map((topic) => (
            <span class="chip">
              {!compact && TOPIC_TO_IMAGE_SRC[topic] && (
                <img src={TOPIC_TO_IMAGE_SRC[topic] ?? ''} alt="" width="12" height="12" loading="lazy" />
              )}
              {TOPIC_TO_NAME[topic]}
            </span>
          ))
        }
        {extraTopics > 0 && <span class="chip chip-more">+{extraTopics}</span>}
      </div>
      <div class="links">
        {
          studyHref !== null && (
            <a href={studyHref} aria-label={`Case study: ${project.title}`}>
              Case study
            </a>
          )
        }
        {
          project.deployment.t === 'public' && (
            <a
              href={project.deployment.url}
              rel="noopener"
              target="_blank"
              aria-label={`Live site: ${project.title}`}
            >
              Live
            </a>
          )
        }
        {
          project.code.t === 'public' && (
            <a
              href={project.code.url}
              rel="noopener"
              target="_blank"
              aria-label={`Source code: ${project.title}`}
            >
              Code
            </a>
          )
        }
        {
          hasGallery && (
            <button
              type="button"
              class="gallery-btn"
              data-gallery={galleryIndex}
              aria-label={`Images: ${project.title}`}
            >
              Images
            </button>
          )
        }
        {note !== null && <span class="access-note">{note}</span>}
      </div>
    </div>
  </div>
  {
    badge !== null && (
      <div class="handwritten-footer" title={badge.title}>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 11V7a2 2 0 0 0-4 0M14 10V5a2 2 0 0 0-4 0v5M10 9.5V7a2 2 0 0 0-4 0v9" />
          <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.9-6-2.4l-3.6-3.6a2 2 0 0 1 2.9-2.9L7 15" />
        </svg>
        {badge.label}
      </div>
    )
  }
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  /* Fixed aspect keeps every row aligned regardless of the source ratio.
     The contents are absolutely positioned so the box's height comes only
     from `aspect-ratio` — in flow, a tall screenshot's natural height wins
     and the cards stop matching. `flex: 0 0 auto` stops the column flex
     parent from shrinking it afterwards. */
  .cover-box {
    position: relative;
    flex: 0 0 auto;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--paper-border);
    background: var(--bg);
    overflow: hidden;
  }
  .project .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Projects with nothing to screenshot (a control plane, a library) still
     need a box of the same size, so they get a wordmark instead. */
  .cover-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--text-muted);
    text-align: center;
    overflow-wrap: anywhere;
  }
  .body {
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }
  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  h3 a {
    color: var(--text);
  }
  h3 a:hover {
    color: var(--accent);
  }
  .desc {
    color: var(--text-muted);
    font-size: var(--text-base);
  }
  .subline {
    font-size: var(--text-sm);
    color: var(--text);
    border-left: 2px solid var(--accent);
    padding-left: var(--space-3);
  }
  /* Featured cards share grid rows; one long description would stretch the
     whole row and leave its neighbours mostly empty. Clamp to a common
     measure; the text stays in the DOM for crawlers and screen readers. */
  .project:not(.compact) .desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    overflow: hidden;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip-more {
    color: var(--text-muted);
  }
  .meta {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  /* `.gallery-btn` is a shared primitive in global.css. */
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--accent);
  }
  .access-note {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
