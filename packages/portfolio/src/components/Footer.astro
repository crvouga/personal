---
import { CONTENT } from '../content/content';
import { RESUME_JSON_PATH } from '../constants/resume';
import { HOSTED_INDEX_PATH } from '../lib/hosted-index';

// Derived at build time: the site is rebuilt daily, so this says how fresh it is.
const built = new Date();
const builtOn = built.toISOString().slice(0, 10);
const year = built.getFullYear();
---

<footer>
  <div class="container inner">
    <p>
      © {year} {CONTENT.PAGE_TITLE} · static site · no cookies, no client-side
      tracking · last built <time datetime={builtOn}>{builtOn}</time>
    </p>
    <nav class="links" aria-label="Site">
      <a href="/projects/">All projects</a>
      <a href={RESUME_JSON_PATH}>résumé.json</a>
      <a href="/llms.txt">llms.txt</a>
      <a href={CONTENT.X_URL} rel="me noopener" target="_blank">X profile</a>
      <a href={CONTENT.SITE_SOURCE_CODE_URL} rel="noopener" target="_blank">
        This site's source
      </a>
      <a class="tiny" href={HOSTED_INDEX_PATH}>
        hosted
      </a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--paper-border);
    padding-block: var(--space-6);
    margin-top: var(--space-6);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text-muted);
  }
  /* Deliberately easy to miss: /hosted/ is an index for Chris, not visitors. */
  footer a.tiny {
    min-width: var(--tap);
    justify-content: center;
    color: var(--text-subtle);
  }
  footer a:hover {
    color: var(--accent);
  }
</style>
