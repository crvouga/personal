---
import type { GalleryItem } from '../lib/projects-view';

interface Props {
  /** Flat array; a `.gallery-btn`'s `data-gallery` indexes into it. */
  galleries: readonly (readonly GalleryItem[])[];
}
const { galleries } = Astro.props;

const galleriesJson = JSON.stringify(galleries);
---

<dialog id="gallery-dialog" class="gallery" aria-label="Project images">
  <div class="stage"></div>
  <div class="bar">
    <button type="button" class="icon-btn" data-step="-1" aria-label="Previous image">
      ‹
    </button>
    <span class="counter" aria-live="polite"></span>
    <button type="button" class="icon-btn" data-step="1" aria-label="Next image">
      ›
    </button>
    <button type="button" class="icon-btn close" data-close aria-label="Close gallery">
      ✕
    </button>
  </div>
</dialog>


<style>
  /* Fixed width, not max-width: a dialog sizes to its content, so letting each
     slide set the width moved the pagination controls on every step. */
  dialog.gallery {
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-lg);
    background: var(--paper);
    padding: var(--space-4);
    width: min(92vw, 1100px);
  }
  dialog.gallery::backdrop {
    background: var(--scrim);
  }
  /* One fixed box for every slide. Portrait screenshots, landscape screenshots
     and 16:9 video all letterbox inside it rather than resizing the dialog. */
  .stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 78vh;
    background: var(--bg);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  /* `:global` because the slide is created by the script below, so it carries
     no scoping attribute — a scoped selector here matches nothing, and both
     the video and the image fall back to their intrinsic size. */
  .stage :global(img),
  .stage :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .stage :global(img) {
    object-fit: contain;
  }
  .stage :global(.video-link) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-md);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .counter {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    min-width: 56px;
    text-align: center;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--text);
    background: transparent;
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .icon-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .icon-btn.close {
    margin-left: auto;
  }
  .icon-btn[hidden] {
    display: none;
  }
</style>

<script is:inline define:vars={{ galleriesJson }}>
  document.addEventListener('DOMContentLoaded', () => {
    const galleries = JSON.parse(galleriesJson);
    const dialog = document.getElementById('gallery-dialog');
    if (!(dialog instanceof HTMLDialogElement)) return;

    const stage = dialog.querySelector('.stage');
    const counter = dialog.querySelector('.counter');
    const steps = dialog.querySelectorAll('[data-step]');
    const closeBtn = dialog.querySelector('[data-close]');
    let items = [];
    let index = 0;

    const render = () => {
      const item = items[index];
      if (!item || !stage) return;
      stage.replaceChildren();
      if (item.kind === 'video') {
        // A link, never an embed: an embedded player sets YouTube cookies and
        // calls ad servers, which would make the footer's promise untrue.
        const id = (item.src.split('/embed/')[1] || '').split('?')[0];
        const link = document.createElement('a');
        link.className = 'video-link';
        link.href = 'https://www.youtube.com/watch?v=' + encodeURIComponent(id);
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = 'Watch this demo video on YouTube ↗';
        stage.append(link);
      } else {
        const img = document.createElement('img');
        img.src = item.src;
        img.alt = item.alt;
        img.loading = 'lazy';
        stage.append(img);
      }
      if (counter) {
        counter.textContent = `${index + 1} / ${items.length}`;
        counter.hidden = items.length < 2;
      }
      steps.forEach((button) => {
        button.hidden = items.length < 2;
      });
    };

    const step = (delta) => {
      if (items.length === 0) return;
      index = (index + delta + items.length) % items.length;
      render();
    };

    document.querySelectorAll('.gallery-btn').forEach((button) => {
      button.addEventListener('click', () => {
        const gallery = galleries[Number(button.dataset.gallery)] ?? [];
        if (gallery.length === 0) return;
        items = gallery;
        index = 0;
        render();
        dialog.showModal();
      });
    });

    steps.forEach((button) => {
      button.addEventListener('click', () => step(Number(button.dataset.step)));
    });

    closeBtn?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        index = 0;
        render();
      } else if (event.key === 'End') {
        event.preventDefault();
        index = Math.max(0, items.length - 1);
        render();
      }
    });

    dialog.addEventListener('close', () => {
      stage?.replaceChildren();
      items = [];
    });
  });
</script>
