---
import { CONTENT } from '../content/content';
import { logisticsLines } from '../content/hero';
import IconGitHub from './icons/IconGitHub.astro';
import IconLinkedIn from './icons/IconLinkedIn.astro';

const section = CONTENT.GET_SECTION('contact');
const email = CONTENT.EMAIL_ADDRESS;
const mailto = `mailto:${email}?subject=${encodeURIComponent(CONTENT.CONTACT_COPY.mailSubject)}`;
const meta = [CONTENT.HERO.availability, CONTENT.HERO.location, ...logisticsLines()];
---

<section id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-heading">
      <span class="number" aria-hidden="true">{section.number}</span>
      <h2 id="contact-title">{section.title}</h2>
    </div>
    <p class="headline">{CONTENT.CONTACT_COPY.headline}</p>
    <p class="sub">{CONTENT.CONTACT_COPY.sub}</p>
    {CONTENT.CONTACT_COPY.lookingFor !== undefined && (
      <p class="sub">{CONTENT.CONTACT_COPY.lookingFor}</p>
    )}
    <p class="meta">{meta.join(' · ')}</p>
    <a class="email" href={mailto}>{email}</a>
    {/* The address above is the call to action; the header holds the résumé. */}
    <div class="ctas">
      <button type="button" class="btn" data-copy={email} aria-label="Copy email address">
        <span class="btn-label">{CONTENT.HERO.ctaCopyLabel}</span>
      </button>
      <a class="btn" href={CONTENT.GITHUB_URL} rel="me noopener" target="_blank">
        <IconGitHub /><span class="btn-label">GitHub</span>
      </a>
      <a class="btn" href={CONTENT.LINKEDIN_URL} rel="me noopener" target="_blank">
        <IconLinkedIn /><span class="btn-label">LinkedIn</span>
      </a>
    </div>
  </div>
</section>

<style>
  .headline {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 600;
  }
  .sub {
    color: var(--text-muted);
    margin-top: var(--space-2);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-2);
  }
  .email {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
