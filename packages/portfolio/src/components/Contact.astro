---
import { CONTENT } from '../content/content';
import { RESUME_HREF } from '../constants/resume';
import IconEmail from './icons/IconEmail.astro';
import IconGitHub from './icons/IconGitHub.astro';
import IconLinkedIn from './icons/IconLinkedIn.astro';
import IconX from './icons/IconX.astro';

const section = CONTENT.GET_SECTION('contact');
const email = CONTENT.EMAIL_ADDRESS;
---

<section id="contact">
  <div class="container">
    <div class="section-heading">
      <span class="number">{section.number}</span>
      <h2>{section.title}</h2>
    </div>
    <p class="headline">{CONTENT.CONTACT_COPY.headline}</p>
    <p class="sub">{CONTENT.CONTACT_COPY.sub}</p>
    <p class="meta">{CONTENT.HERO.availability} · {CONTENT.HERO.location}</p>
    <a class="email" href={`mailto:${email}`}>{email}</a>
    <div class="ctas">
      <a class="btn btn-contained" href={`mailto:${email}`}>
        <IconEmail /><span class="btn-label">{CONTENT.CONTACT_COPY.ctaPrimary.label}</span>
      </a>
      <button type="button" class="btn" data-copy={email}>
        <span class="btn-label">{CONTENT.HERO.ctaCopyLabel}</span>
      </button>
      <a class="btn" href={RESUME_HREF} target="_blank" rel="noopener">
        <span class="btn-label">Résumé</span>
      </a>
      <a class="btn" href={CONTENT.GITHUB_URL} rel="me noopener" target="_blank">
        <IconGitHub /><span class="btn-label">GitHub</span>
      </a>
      <a
        class="btn"
        href={CONTENT.LINKEDIN_URL}
        rel="me noopener"
        target="_blank"
      >
        <IconLinkedIn /><span class="btn-label">LinkedIn</span>
      </a>
      <a class="btn" href={CONTENT.X_URL} rel="me noopener" target="_blank">
        <IconX /><span class="btn-label">X</span>
      </a>
    </div>
  </div>
</section>

<style>
  .headline {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 600;
  }
  .sub {
    color: var(--text-muted);
    margin-top: var(--space-2);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
    margin-top: var(--space-2);
  }
  .email {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
