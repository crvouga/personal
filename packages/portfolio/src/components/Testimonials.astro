---
import { COMMUNITY, shownTestimonials } from '../content/testimonials';

// Renders nothing at all until there are enough attributed quotes; an empty
// or placeholder block would cost more trust than it earns.
const quotes = shownTestimonials();
---

{
  (quotes.length > 0 || COMMUNITY.length > 0) && (
    <section id="people" aria-labelledby="people-title">
      <div class="container">
        <h2 id="people-title" class="title">What people say</h2>
        <div class="quotes">
          {quotes.map((t) => (
            <figure class="card quote">
              <blockquote cite={t.sourceUrl}>
                <p>{t.quote}</p>
              </blockquote>
              <figcaption>
                <a href={t.sourceUrl} rel="noopener" target="_blank">
                  {t.name}
                </a>
                , {t.title}
              </figcaption>
            </figure>
          ))}
        </div>
        {COMMUNITY.length > 0 && (
          <ul class="community">
            {COMMUNITY.map((item) => (
              <li>
                <a href={item.href} rel="noopener" target="_blank">{item.label}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .title {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-5);
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .quote {
    margin: 0;
    padding: var(--space-5);
  }
  blockquote {
    margin: 0;
    color: var(--text);
  }
  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .community {
    margin-top: var(--space-4);
    padding-left: var(--space-5);
    color: var(--text-muted);
  }
</style>
