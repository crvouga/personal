---
import ContributionHeatmap from './ContributionHeatmap.astro';
import type { ContributionRange } from '../lib/github';

interface Props {
  range: ContributionRange;
}
const { range } = Astro.props;

const count = (value: number): string => value.toLocaleString('en-US');

/** The account's first year can hold a single contribution; "1 days" is wrong. */
const plural = (value: number, noun: string): string =>
  `${count(value)} ${noun}${value === 1 ? '' : 's'}`;
const LEVEL_CLASSES = ['c0', 'c1', 'c2', 'c3', 'c4'];
---

<div class="gh-calendar">
  <p class="panel-total">
    <strong>{count(range.totalContributions)}</strong>
    {range.totalContributions === 1 ? 'contribution' : 'contributions'}
    <span class="panel-window">{`${range.label} · ${range.from} → ${range.to}`}</span>
  </p>
  <ContributionHeatmap range={range} />
  <p class="panel-meta">
    {`${plural(range.activeDays, 'active day')} · longest streak ${plural(range.longestStreak, 'day')} · busiest day ${count(range.busiestCount)}`}
  </p>
  <div class="legend" aria-hidden="true">
    <span>Less</span>
    {LEVEL_CLASSES.map((level) => <span class={`swatch ${level}`} />)}
    <span>More</span>
  </div>
</div>

<style>
  .panel-total {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }
  .panel-total strong {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text);
  }
  .panel-window {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .panel-meta {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .legend {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-2);
  }
  .swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }
  .swatch.c0 {
    background: var(--gh-0);
  }
  .swatch.c1 {
    background: var(--gh-1);
  }
  .swatch.c2 {
    background: var(--gh-2);
  }
  .swatch.c3 {
    background: var(--gh-3);
  }
  .swatch.c4 {
    background: var(--gh-4);
  }
  @media (max-width: 599px) {
    .panel-window {
      margin-left: 0;
      flex-basis: 100%;
    }
    .legend {
      justify-content: flex-start;
    }
  }
</style>

<script is:inline>
  // Progressive enhancement only: park the grid at its most recent week, which
  // is the part people look at. Without JavaScript it simply starts at the left.
  // The calendar sits in a closed <details>, so it is parked again on open.
  document.addEventListener('DOMContentLoaded', () => {
    const park = () =>
      document.querySelectorAll('[data-heatmap-scroll]').forEach((scroller) => {
        scroller.scrollLeft = scroller.scrollWidth;
      });
    park();
    document.querySelectorAll('details').forEach((details) => {
      details.addEventListener('toggle', park);
    });
  });
</script>
