---
/**
 * The homepage for one presentation. The page that renders this sets
 * `Astro.locals.presentation` first; every section reads it from there, so
 * the order, the headings, the ranking and the voice all come from one place.
 */
import { presentationOf } from '../archetypes/presentation';
import type { SectionId } from '../content/sections';
import Base from '../layouts/Base.astro';
import About from './About.astro';
import Agentic from './Agentic.astro';
import Contact from './Contact.astro';
import Experience from './Experience.astro';
import Footer from './Footer.astro';
import GalleryDialog from './GalleryDialog.astro';
import Hero from './Hero.astro';
import Nav from './Nav.astro';
import ProofOfWork from './ProofOfWork.astro';
import Projects from './Projects.astro';
import StickyCta from './StickyCta.astro';
import Testimonials from './Testimonials.astro';

const presentation = presentationOf(Astro);

const SECTION_COMPONENTS = {
  work: Experience,
  projects: Projects,
  agentic: Agentic,
  proof: ProofOfWork,
  about: About,
  contact: Contact,
} satisfies Record<SectionId, unknown>;
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    {
      presentation.sections.map((section) => {
        const Section = SECTION_COMPONENTS[section.id];
        // Quotes belong beside the proof they vouch for, wherever that sits.
        return (
          <>
            <Section />
            {section.id === 'proof' && <Testimonials />}
          </>
        );
      })
    }
  </main>
  <Footer />
  <StickyCta />
  <GalleryDialog galleries={presentation.galleries} />
</Base>
