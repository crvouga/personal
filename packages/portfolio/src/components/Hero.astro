---
import { CONTENT } from '../content/content';
import { logisticsLines } from '../content/hero';
import { HERO_PROOF_CHIPS } from '../lib/proof-view';
import IconEmail from '../components/icons/IconEmail.astro';
import IconGitHub from '../components/icons/IconGitHub.astro';
import IconLinkedIn from '../components/icons/IconLinkedIn.astro';

const email = CONTENT.EMAIL_ADDRESS;
const logistics = [CONTENT.HERO.location, ...logisticsLines()];
// X stays in the footer only: the hero's quiet icons are the two profiles a
// reviewer actually opens.
const socials = [
  { label: 'GitHub profile', href: CONTENT.GITHUB_URL, Icon: IconGitHub },
  { label: 'LinkedIn profile', href: CONTENT.LINKEDIN_URL, Icon: IconLinkedIn },
];
---

<section id="top" class="hero" aria-labelledby="hero-name">
  <div class="container">
    <p class="eyebrow">{CONTENT.HERO.eyebrow}</p>
    <h1 id="hero-name">{CONTENT.HERO.name}</h1>
    <p class="statement">{CONTENT.HERO.statement}</p>
    <p class="statement-secondary">{CONTENT.HERO.statementSecondary}</p>
    {/* Evidence for the statement, one click from the claim. Each number is
        rendered from a committed snapshot, never typed. */}
    <ul class="proof-chips" aria-label="Evidence">
      {
        HERO_PROOF_CHIPS.map((chip) => (
          <li>
            <a class="proof-chip" href={chip.href}>
              <strong>{chip.value}</strong> {chip.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="status">
      <p class="pill">
        <span class="dot" aria-hidden="true"></span>{CONTENT.HERO.availability}
      </p>
      <p class="logistics">{logistics.join(' · ')}</p>
    </div>
    {/* The header's Résumé button is on screen everywhere, so the hero offers
        email and profiles rather than a second copy of it. */}
    <p class="print-only">{email} · {CONTENT.SITE_URL.replace(/^https:\/\//, '')}</p>
    <div class="ctas" data-hero-ctas>
      <a class="btn btn-contained" href={`mailto:${email}?subject=${encodeURIComponent(CONTENT.CONTACT_COPY.mailSubject)}`}>
        <IconEmail /><span class="btn-label">{CONTENT.HERO.ctaPrimary.label}</span>
      </a>
      <div class="socials">
        {
          socials.map(({ label, href, Icon }) => (
            <a
              class="icon-link"
              href={href}
              rel="me noopener"
              target="_blank"
              aria-label={label}
              title={label}
            >
              <Icon />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: 120px var(--space-8);
    }
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: var(--space-4);
  }
  h1 {
    font-family: var(--font-mono);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  /* The differentiator: the largest text after the name. */
  .statement {
    max-width: 38ch;
    font-size: clamp(22px, 2.8vw, 30px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-top: var(--space-5);
  }
  .statement-secondary {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: var(--text-md);
    margin-top: var(--space-4);
  }
  .proof-chips {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .proof-chip {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    background: var(--paper);
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-pill);
  }
  .proof-chip strong {
    color: var(--accent);
    font-weight: 700;
  }
  .proof-chip:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding: 6px var(--space-3);
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .logistics {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  /* One flex item, so the icons wrap together or not at all. Each glyph sits
     inside a full-size tap target; the negative margin pulls the first one
     back so it lines up with the text edge when the group wraps on a phone. */
  .socials {
    display: flex;
    gap: var(--space-1);
    margin-left: -10px;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition: color var(--motion-fast) var(--motion-ease);
  }
  .icon-link:hover {
    color: var(--accent);
  }
  .icon-link :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
