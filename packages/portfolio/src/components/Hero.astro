---
import { CONTENT } from '../content/content';
import { logisticsLines } from '../content/hero';
import IconEmail from '../components/icons/IconEmail.astro';
import IconGitHub from '../components/icons/IconGitHub.astro';
import IconLinkedIn from '../components/icons/IconLinkedIn.astro';

const email = CONTENT.EMAIL_ADDRESS;
// X stays in the footer only: the hero's quiet icons are the two profiles a
// reviewer actually opens.
const socials = [
  { label: 'GitHub profile', href: CONTENT.GITHUB_URL, Icon: IconGitHub },
  { label: 'LinkedIn profile', href: CONTENT.LINKEDIN_URL, Icon: IconLinkedIn },
];
---

<section id="top" class="hero" aria-labelledby="hero-name">
  <div class="container">
    <p class="eyebrow">{CONTENT.HERO.eyebrow}</p>
    <h1 id="hero-name">{CONTENT.HERO.name}</h1>
    {/* Deliberately short: who, what, and how to reach me. The evidence is
        further down the page, where it can be explained. */}
    <p class="statement">{CONTENT.HERO.statement}</p>
    <div class="status">
      <p class="pill">
        <span class="dot" aria-hidden="true"></span>{CONTENT.HERO.availability}
      </p>
      {/* Location, work authorization, time zone: a recruiter's first filters. */}
      <p class="logistics">{[CONTENT.HERO.location, ...logisticsLines()].join(' · ')}</p>
    </div>
    {/* The header's Résumé button is on screen everywhere, so the hero offers
        email and profiles rather than a second copy of it. */}
    <p class="print-only">{email} · {CONTENT.SITE_URL.replace(/^https:\/\//, '')}</p>
    <div class="ctas" data-hero-ctas>
      <a class="btn btn-contained" href={`mailto:${email}?subject=${encodeURIComponent(CONTENT.CONTACT_COPY.mailSubject)}`}>
        <IconEmail /><span class="btn-label">{CONTENT.HERO.ctaPrimary.label}</span>
      </a>
      <div class="socials">
        {
          socials.map(({ label, href, Icon }) => (
            <a
              class="icon-link"
              href={href}
              rel="me noopener"
              target="_blank"
              aria-label={label}
              title={label}
            >
              <Icon />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: 120px var(--space-8);
    }
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: var(--space-4);
  }
  h1 {
    font-family: var(--font-mono);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  /* The differentiator: the largest text after the name. */
  .statement {
    max-width: 38ch;
    font-size: clamp(22px, 2.8vw, 30px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-top: var(--space-5);
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding: 6px var(--space-3);
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-pill);
  }
  .logistics {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  /* One flex item, so the icons wrap together or not at all. Each glyph sits
     inside a full-size tap target; the negative margin pulls the first one
     back so it lines up with the text edge when the group wraps on a phone. */
  .socials {
    display: flex;
    gap: var(--space-1);
    margin-left: -10px;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition: color var(--motion-fast) var(--motion-ease);
  }
  .icon-link:hover {
    color: var(--accent);
  }
  .icon-link :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
