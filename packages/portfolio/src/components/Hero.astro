---
import { CONTENT } from '../content/content';
import { RESUME_HREF } from '../constants/resume';
import { TOPIC_TO_NAME } from '../content/topic';
import IconEmail from '../components/icons/IconEmail.astro';
import IconDownload from '../components/icons/IconDownload.astro';
import IconGitHub from '../components/icons/IconGitHub.astro';
import IconLinkedIn from '../components/icons/IconLinkedIn.astro';
import IconX from '../components/icons/IconX.astro';

const email = CONTENT.EMAIL_ADDRESS;
const currentJob = CONTENT.WORK.find((job) => job.yearEnd === 'Present');
const sinceYear = CONTENT.WORK.reduce(
  (earliest, job) => Math.min(earliest, job.yearStart),
  new Date().getFullYear()
);
const stack = CONTENT.CORE_STACK.map((topic) => TOPIC_TO_NAME[topic]).join(' · ');
const socials = [
  { label: 'GitHub', href: CONTENT.GITHUB_URL, Icon: IconGitHub },
  { label: 'LinkedIn', href: CONTENT.LINKEDIN_URL, Icon: IconLinkedIn },
  { label: 'X', href: CONTENT.X_URL, Icon: IconX },
];
---

<section id="top" class="hero">
  <div class="container hero-grid">
    <div class="intro">
      <p class="eyebrow">{CONTENT.HERO.eyebrow}</p>
      <h1>{CONTENT.HERO.name}</h1>
      <p class="statement">{CONTENT.HERO.statement}</p>
      <p class="statement-secondary">{CONTENT.HERO.statementSecondary}</p>
      <p class="pill">
        <span class="dot" aria-hidden="true"></span>{CONTENT.HERO.availability}
      </p>
      <div class="ctas">
        <a class="btn btn-contained" href={`mailto:${email}`}>
          <IconEmail /><span class="btn-label">{CONTENT.HERO.ctaPrimary.label}</span>
        </a>
        <a class="btn" href={RESUME_HREF} target="_blank" rel="noopener">
          <IconDownload /><span class="btn-label">Résumé</span>
        </a>
        {/* Two labelled actions, then the profiles as quiet icons: five equal
            buttons wrapped onto a second row and competed with the pitch. */}
        <div class="socials">
          {
            socials.map(({ label, href, Icon }) => (
              <a
                class="icon-link"
                href={href}
                rel="me noopener"
                target="_blank"
                aria-label={label}
                title={label}
              >
                <Icon />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <aside class="card now">
      <p class="now-label">// currently</p>
      {/* The company only: the eyebrow already states the level. */}
      {currentJob !== undefined && <h2 class="now-role">{currentJob.name}</h2>}
      <p class="now-since">Shipping production software since {sinceYear}</p>
      <p class="now-loc">{CONTENT.HERO.location}</p>
      <p class="now-stack">{stack}</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }
  .statement-secondary {
    max-width: 60ch;
    color: var(--text-muted);
    font-size: var(--text-base);
    margin-top: var(--space-3);
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: 140px var(--space-8);
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(280px, 1fr);
    }
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: var(--space-4);
  }
  h1 {
    font-family: var(--font-mono);
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .statement {
    max-width: 560px;
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-top: var(--space-5);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding: 6px var(--space-3);
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-pill);
    margin-top: var(--space-5);
    white-space: nowrap;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  /* One flex item, so the icons wrap together or not at all. Each glyph sits
     inside a full-size tap target; the negative margin pulls the first one
     back so it lines up with the text edge when the group wraps on a phone. */
  .socials {
    display: flex;
    gap: var(--space-1);
    margin-left: -10px;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition: color var(--motion-fast) var(--motion-ease);
  }
  .icon-link:hover {
    color: var(--accent);
  }
  .icon-link :global(svg) {
    width: 18px;
    height: 18px;
  }
  .now {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .now-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
  .now-role {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
  }
  .now-since,
  .now-loc {
    font-size: var(--text-base);
    color: var(--text-muted);
  }
  .now-stack {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--paper-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }
</style>
