---
/**
 * The design system at a glance, in whatever theme surrounds it: every colour
 * token, the three type roles, shape, and the shared primitives (buttons,
 * chip, card, section heading). One story per role shows its look.
 */
import { isRoleId, DEFAULT_ROLE_ID } from '../roles/definitions';
import { THEMES } from '../roles/theme';
import { colorVars } from './css';

interface Props {
  role?: string;
}
const id =
  Astro.props.role !== undefined && isRoleId(Astro.props.role)
    ? Astro.props.role
    : DEFAULT_ROLE_ID;
const theme = THEMES[id];
const tokens = Object.keys(colorVars(theme.light));
---

<div class="container showcase">
  <header class="section-heading">
    <span class="number">00</span>
    <h2>{id}</h2>
  </header>
  <p class="description">{theme.description}</p>

  <h3 class="label">Colour</h3>
  <ul class="swatches">
    {
      tokens.map((token) => (
        <li>
          <svg class="swatch" aria-hidden="true" focusable="false">
            <rect class={`fill-${token}`} width="100%" height="100%" />
          </svg>
          <code>--{token}</code>
        </li>
      ))
    }
  </ul>

  <h3 class="label">Type</h3>
  <div class="type card">
    <p class="display">Display: the headline face</p>
    <p class="accent">Accent: labels, eyebrows, metadata</p>
    <p class="body">Body: running text that a reviewer reads end to end, set for comfort at length.</p>
  </div>

  <h3 class="label">Primitives</h3>
  <div class="primitives">
    <a class="btn btn-contained" href="#top"><span class="btn-label">Primary</span></a>
    <a class="btn" href="#top"><span class="btn-label">Secondary</span></a>
    <span class="chip">Chip</span>
    <a class="inline-link" href="#top">Inline link</a>
    <strong class="handwritten-text">Hand-written</strong>
  </div>
  <article class="card sample">
    <h3>Card title</h3>
    <p>Cards hold projects, roles and proof. Corners, borders and surface come from the theme.</p>
  </article>
</div>

<style>
  .showcase {
    padding-block: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .description {
    max-width: 70ch;
    color: var(--text-muted);
  }
  .label {
    margin-top: var(--space-4);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    color: var(--text-subtle);
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .swatches li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .swatch {
    width: 100%;
    height: 40px;
    border: 1px solid var(--paper-border);
    border-radius: var(--radius-sm);
  }
  .type {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .display {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: var(--text-2xl);
  }
  .accent {
    font-family: var(--font-accent);
    color: var(--accent);
  }
  .body {
    font-family: var(--font-body);
    color: var(--text-muted);
  }
  .primitives {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .sample {
    padding: var(--space-5);
    max-width: 420px;
  }
  .sample h3 {
    font-family: var(--font-display);
    margin-bottom: var(--space-2);
  }
</style>

<style is:inline set:html={tokens.map((token) => `.fill-${token}{fill:var(--${token})}`).join('')}></style>
