---
/**
 * The frame of every page but the homepage: header, `<main>`, footer. Kept
 * apart from `Base` (the document) so Storybook can render a whole screen.
 */
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import type { RoleId } from '../roles/definitions';

interface Props {
  role?: RoleId;
}
const { role } = Astro.props;
---

<Nav variant="sub" role={role} />
<main id="main">
  <slot />
</main>
<Footer />
