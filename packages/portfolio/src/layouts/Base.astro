---
import '../styles/global.css';
import {
  ARCHETYPE_PARAM,
  presentationOf,
} from '../archetypes/presentation';
import { ALL_THEMES_CSS, LOOKS_BY_ARCHETYPE } from '../archetypes/theme';
import {
  HOME_SEO,
  SITE_NAME,
  TOUCH_ICON_PATH,
  X_HANDLE,
  absoluteUrl,
} from '../lib/seo';
import { buildJsonLd } from '../lib/seo-json-ld';
import type { Seo } from '../lib/seo-types';
import { publishedPosts } from '../lib/published-posts';

interface Props {
  /** Omitted by the homepage, which is the canonical Person + WebSite page. */
  seo?: Seo;
}
// A presentation keeps the homepage's canonical URL and share card, but its
// description is its own pitch, so a shared `?archetype=` link previews it.
const presentation = presentationOf(Astro);
const { seo = { ...HOME_SEO, description: presentation.voice.statement } } =
  Astro.props;
const forcedLight = presentation.theme.scheme === 'light';
// A homepage is built per archetype and carries its one theme. Every other
// page is built once: it carries all of them, and the script below applies
// the one named in the URL, so the look follows a visitor past the homepage.
const shared = Astro.locals.presentation === undefined;
const styles = shared ? ALL_THEMES_CSS : presentation.themeCss;
const canonical = absoluteUrl(seo.path);
const jsonLd = buildJsonLd(seo);
const hasFeed = (await publishedPosts()).length > 0;
---

<!doctype html>
<html lang="en" data-archetype={presentation.id} data-look={presentation.theme.looks.join(' ') || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content={SITE_NAME} />
    {/* A 404 has no canonical URL of its own. */}
    {seo.noindex !== true && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href={TOUCH_ICON_PATH} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {hasFeed && <link rel="alternate" type="application/rss+xml" title="Writing" href="/rss.xml" />}
    {!forcedLight && <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />}
    <meta name="theme-color" content="#f4f6f9" media={forcedLight ? undefined : '(prefers-color-scheme: light)'} />
    <meta name="color-scheme" content={forcedLight ? 'light' : 'dark light'} />
    {/* In-app browsers on iOS turn any digit run into a tappable phone
        number or calendar link; the date ranges on this page are neither. */}
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <meta name="generator" content={Astro.generator} />
    {seo.noindex === true && <meta name="robots" content="noindex" />}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-variable.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-variable.woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {/* `name="image"` as well as the property: LinkedIn reads either, and
        its inspector warns when the name form is missing. */}
    <meta name="image" property="og:image" content={seo.image.url} />
    <meta property="og:image:type" content={seo.image.type} />
    <meta property="og:image:alt" content={seo.image.alt} />
    <meta property="og:image:width" content={String(seo.image.width)} />
    <meta property="og:image:height" content={String(seo.image.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={X_HANDLE} />
    <meta name="twitter:creator" content={X_HANDLE} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image.url} />
    <meta name="twitter:image:alt" content={seo.image.alt} />
    {styles !== '' && <style is:inline set:html={styles} />}
    {shared && (
      <script is:inline define:vars={{ archetypeParam: ARCHETYPE_PARAM, looks: LOOKS_BY_ARCHETYPE }}>
        const id = new URLSearchParams(window.location.search).get(archetypeParam);
        if (id !== null && Object.hasOwn(looks, id)) {
          document.documentElement.dataset.archetype = id;
          if (looks[id] !== '') document.documentElement.dataset.look = looks[id];
        }
      </script>
    )}
    {jsonLd !== null && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
    <slot />
  </body>
</html>

<script is:inline define:vars={{ archetypeParam: ARCHETYPE_PARAM }}>
  // A visitor who arrived on `?archetype=<id>` keeps that presentation: every
  // same-site link carries the parameter on. Without scripting the page still
  // works; its own résumé and project links are already built with it.
  (() => {
    const value = new URLSearchParams(window.location.search).get(archetypeParam);
    if (value === null || !/^[a-z0-9-]{1,64}$/.test(value)) return;
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('a[href^="/"]').forEach((link) => {
        const url = new URL(link.getAttribute('href'), window.location.origin);
        if (url.searchParams.has(archetypeParam)) return;
        url.searchParams.set(archetypeParam, value);
        link.setAttribute('href', url.pathname + url.search + url.hash);
      });
    });
  })();
</script>

<script is:inline>
  // Paper has no disclosure triangles: print everything that is folded.
  window.addEventListener('beforeprint', () => {
    document.querySelectorAll('details').forEach((details) => {
      details.open = true;
    });
  });

  document.addEventListener('DOMContentLoaded', () => {
    const status = document.querySelector('[data-copy-status]');
    const announce = (message) => {
      if (status) status.textContent = message;
    };

    // In-app browsers often ship without the async clipboard API, or reject
    // it. A selection-based copy still works there, and only when both fail
    // does the caller fall through to mailto.
    const copyText = (value) => {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(value).catch(() => legacyCopy(value));
      }
      return legacyCopy(value);
    };
    const legacyCopy = (value) =>
      new Promise((resolve, reject) => {
        const field = document.createElement('textarea');
        field.value = value;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.appendChild(field);
        field.select();
        const copied = document.execCommand('copy');
        field.remove();
        if (copied) resolve();
        else reject(new Error('copy failed'));
      });

    document.querySelectorAll('[data-copy]').forEach((el) => {
      el.addEventListener('click', (event) => {
        event.preventDefault();
        const value = el.getAttribute('data-copy') || '';
        const label = el.querySelector('.btn-label');
        const original = label ? label.textContent : null;
        copyText(value).then(
          () => {
            if (label && original !== null) {
              label.textContent = 'Copied';
              window.setTimeout(() => {
                label.textContent = original;
              }, 2000);
            }
            announce('Copied ' + value + ' to the clipboard');
          },
          () => {
            window.location.href = 'mailto:' + value;
          }
        );
      });
    });
  });
</script>
