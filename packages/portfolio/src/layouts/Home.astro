---
/**
 * The homepage document for one presentation. The page that renders this
 * sets `Astro.locals.presentation` first; the body is `HomeScreen`.
 */
import { presentationOf } from '../archetypes/presentation';
import Base from '../layouts/Base.astro';
import HomeScreen from '../screens/HomeScreen.astro';

const presentation = presentationOf(Astro);
---

<Base>
  <HomeScreen archetype={presentation.id} />
</Base>
