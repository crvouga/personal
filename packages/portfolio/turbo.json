{
  "$schema": "https://v2-10-13.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "tc": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tsconfig.strict.json",
        "$TURBO_ROOT$/packages/infra/tofu/modules/inventory/**"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tsconfig.strict.json",
        "$TURBO_ROOT$/packages/infra/tofu/modules/inventory/**",
        "$TURBO_ROOT$/packages/eslint-rules/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tsconfig.strict.json",
        "$TURBO_ROOT$/packages/infra/tofu/modules/inventory/**",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/packages/infra/tofu/**/*.tf",
        "$TURBO_ROOT$/packages/infra/lib/health/**",
        "$TURBO_ROOT$/scripts/agent-commands.ts"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../tsconfig.strict.json",
        "$TURBO_ROOT$/packages/infra/tofu/modules/inventory/**"
      ],
      "outputs": ["dist/**"]
    },
    "test:site": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
