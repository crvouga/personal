[Unit]
Description=Consistent encrypted CLIProxyAPI backup to independent R2 storage
Requires=docker.service
After=docker.service network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/cliproxy-fleet
ExecStart=/opt/cliproxy-fleet/scripts/backup backup
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
