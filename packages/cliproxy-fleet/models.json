  "simulations": [
    {
      "id": "failover_after_quota",
      "capability": "routing.failover",
      "title": "First account's quota is exhausted; the request fails over to the second",
      "accounts": [
        {
          "id": "acct-a",
          "quota": 0
        },
        {
          "id": "acct-b"
        }
      ],
      "steps": [
        {
          "request": {
            "protocol": "chat",
            "turn": {
              "messages": [
                {
                  "role": "user",
                  "content": "Reply with the single word OK."
                }
              ],
              "max_tokens": 64
            }
          },
          "count": 1,
          "expect": {
            "status": 200,
            "served_by_all": ["acct-b"]
          }
        },
        {
          "request": {
            "protocol": "chat",
            "turn": {
              "messages": [
                {
                  "role": "user",
                  "content": "Reply with the single word OK."
                }
              ],
              "max_tokens": 64
            }
          },
          "count": 3,
          "expect": {
            "status": 200,
            "served_by_all": ["acct-b"]
          }
        }
      ]
    },
    {
      "id": "fill_first_drains_one_account_before_the_next",
      "capability": "routing.fill_first",
      "title": "Three accounts with limited quota are used strictly in order: all of the first, then the second, then the third",
      "accounts": [
        {
          "id": "acct-a",
          "quota": 3
        },
        {
          "id": "acct-b",
          "quota": 3
        },
        {
          "id": "acct-c"
        }
      ],
      "steps": [
        {
          "request": {
            "protocol": "chat"
          },
          "count": 8,
          "expect": {
            "status": 200,
            "served_sequence": [
              "acct-a",
              "acct-a",
              "acct-a",
              "acct-b",
              "acct-b",
              "acct-b",
              "acct-c",
              "acct-c"
            ]
          }
        }
      ]
    },
    {
      "id": "fill_first_does_not_spread_load",
      "capability": "routing.fill_first",
      "title": "With capacity available, every new session goes to the first account and the others stay idle",
      "accounts": [
        {
          "id": "acct-a"
        },
        {
          "id": "acct-b"
        },
        {
          "id": "acct-c"
        }
      ],
      "steps": [
        {
          "request": {
