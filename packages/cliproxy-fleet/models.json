            "served_by_all": ["acct-a"]
          }
        }
      ]
    },
    {
      "id": "fill_first_returns_to_the_first_account_after_it_recovers",
      "capability": "routing.fill_first",
      "title": "After the first account's quota returns and its cooldown ends, new sessions fill it again before the second",
      "accounts": [
        {
          "id": "acct-a",
          "quota": 1
        },
        {
          "id": "acct-b"
        }
      ],
      "steps": [
        {
          "request": {
            "protocol": "chat"
          },
          "count": 2,
          "expect": {
            "status": 200,
            "served_sequence": ["acct-a", "acct-b"]
          }
        },
        {
          "action": "account",
          "id": "acct-a",
          "quota": null
        },
        {
          "action": "advance",
          "seconds": 31
        },
        {
          "request": {
            "protocol": "chat"
          },
          "count": 3,
          "expect": {
            "status": 200,
            "served_by_all": ["acct-a"]
          }
        }
      ]
    },
    {
      "id": "transient_failure_cools_the_account_then_it_rejoins",
      "capability": "routing.recovery",
      "title": "A transient upstream error sends the request to the next account, keeps the failed one cooling for 60s, then it serves again",
