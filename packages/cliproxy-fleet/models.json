            "served_by_all": ["acct-b"]
          }
        },
        {
          "action": "advance",
          "seconds": 61
        },
        {
          "request": {
            "protocol": "chat"
          },
          "count": 1,
          "expect": {
            "status": 200,
            "served_by_all": ["acct-a"]
          }
        }
      ]
