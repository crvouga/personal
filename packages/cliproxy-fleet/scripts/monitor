#!/usr/bin/env python3
import sys

sys.dont_write_bytecode = True

import datetime, json, pathlib, subprocess, sys, os

r = pathlib.Path(os.environ.get("CLIPROXY_ROOT", "/opt/cliproxy-fleet")).resolve()
issues = []
provenance = subprocess.run([str(r / "scripts/audit.py")], capture_output=True)
if provenance.returncode:
    issues.append("Installed code differs from its committed-source manifest.")
p = subprocess.run([str(r / "scripts/ops"), "health"], capture_output=True)
if p.returncode:
    issues.append("Application health/authentication failed; inspect sanitized logs.")
f = r / "state/status/backup-success.json"
if not f.exists():
    issues.append("No successful independent backup has been recorded.")
else:
    try:
        t = datetime.datetime.fromisoformat(json.loads(f.read_text())["time"])
        if (
            datetime.datetime.now(datetime.timezone.utc) - t
        ).total_seconds() > 36 * 3600:
            issues.append("Backup older than 36 hours.")
    except Exception:
        issues.append("Invalid backup status record.")
if (r / "state/status/vault-failed").exists():
    issues.append("Vault login/renewal failed; backups cannot fetch credentials.")
for marker in ["backup-failed", "backup-check-failed", "backup-operation-failed"]:
    if (r / "state/status" / marker).exists():
        issues.append(marker + ": inspect failed operation.")
f = r / "state/status/monitor-failed"
if issues:
    f.write_text("\n".join(issues) + "\n")
    if os.geteuid() == 0:
        os.chown(f, 1000, 1000)
    print(f.read_text())
    sys.exit(1)
f.unlink(missing_ok=True)
print("Health and backup freshness passed.")
