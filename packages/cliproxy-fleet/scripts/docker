#!/usr/bin/env python3
import sys

sys.dont_write_bytecode = True

import os, pathlib

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import cliproxy_host

args = sys.argv[1:]
if args and args[0] == "compose" and "--project-directory" not in args:
    args = [
        "compose",
        "--project-directory",
        str(cliproxy_host.default_root()),
        *args[1:],
    ]
try:
    argv, environment = cliproxy_host.docker_invocation(args, __file__)
except cliproxy_host.DockerUnavailable as error:
    print(str(error), file=sys.stderr)
    sys.exit(cliproxy_host.DOCKER_UNAVAILABLE)
os.execvpe(argv[0], argv, environment)
