#!/usr/bin/env python3
import sys

sys.dont_write_bytecode = True

import fcntl, json, os, pathlib, shutil, subprocess, sys, tempfile, time, urllib.request, urllib.error

root = pathlib.Path(os.environ.get("CLIPROXY_ROOT", "/opt/cliproxy-fleet")).resolve()
os.environ["PATH"] = str(root / "scripts") + ":" + os.environ["PATH"]
os.umask(0o077)
os.chdir(root)


def run(args, **kw):
    return subprocess.run(args, check=True, **kw)


def compose(*args, **kw):
    return run(["docker", "compose", *args], **kw)


def validate():
    if (root / "state/recovery-incomplete").exists():
        raise ValueError("Interrupted cache recovery must be resolved before startup")
    run([str(root / "scripts/validate-config")])
    compose("config", "--quiet")


def request(path, key=None, data=None, base="http://127.0.0.1:8317"):
    headers = {}
    if key:
        headers["Authorization"] = "Bearer " + key
    if data is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(
        base + path,
        data=json.dumps(data).encode() if data is not None else None,
        headers=headers,
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()


def health():
    key = (root / "state/secrets/client-key").read_text().strip()
    assert request("/v1/models")[0] == 401, (
        "Anonymous inference accepted or unavailable"
    )
    code, body = request("/v1/models", key)
    assert code == 200, "Authenticated model listing failed"
    assert request("/v0/management/config", key)[0] in (401, 403), (
        "Client key accessed management"
    )
    admin = (root / "state/secrets/management-key").read_text().strip()
    assert request("/v0/management/config", admin)[0] == 200, (
        "Management authentication failed"
    )
    assert request("/management.html")[0] == 200, "Official dashboard unavailable"
    models = json.loads(body).get("data", [])
    if not isinstance(models, list) or not models:
        raise ValueError("No usable provider models")
    print(
        "PASS: anonymous rejected; client models OK; separate management key enforced; dashboard available."
    )
    print("Available model count:", len(models))
    return models


def wait():
    for _ in range(30):
        try:
            health()
            return
        except Exception:
            time.sleep(2)
    sys.exit(
        "Health did not recover in 60 seconds. Inspect status; use rollback if upgrading."
    )


def lock():
    f = open(root / "state/status/operation.lock", "w")
    if os.geteuid() == 0:
        os.chown(root / "state/status/operation.lock", 1000, 1000)
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def staging(config):
    # No provider credential files are mounted; isolated port and temporary state.
    import yaml

    with tempfile.TemporaryDirectory(prefix="cliproxy-stage-") as d:
        stage = pathlib.Path(d)
        stage.chmod(0o755)
        cfg = yaml.safe_load(pathlib.Path(config).read_text())
        cfg["server"]["port"] = 8317
        cfg["oauth"] = {"auth-dir": "/stage/auths"}
        cfg["management"]["disable-control-panel"] = True
        for field in [
            "api-keys",
            "gemini-api-key",
            "claude-api-key",
            "codex-api-key",
            "openai-compatibility",
            "xai-api-key",
            "meta-api-key",
        ]:
            cfg.pop(field, None)
        cfg["management"]["disable-auto-update-panel"] = True
        (stage / "auths").mkdir(mode=0o700)
        (stage / "config.yaml").write_text(yaml.safe_dump(cfg))
        (stage / "config.yaml").chmod(0o600)
        image = dict(
            line.split("=", 1) for line in (root / ".env").read_text().splitlines()
        )["CLI_PROXY_IMAGE"]
        name = "cliproxy-validate-" + str(os.getpid())
        try:
            run(
                [
                    "docker",
                    "run",
                    "-d",
                    "--name",
                    name,
                    "--user",
                    "1000:1000",
                    "--cap-drop=ALL",
                    "--security-opt=no-new-privileges",
                    "--memory=512m",
                    "--pids-limit=128",
                    "-v",
                    str(stage) + ":/stage",
                    "-p",
                    "127.0.0.1::8317",
                    image,
                    "/CLIProxyAPI/CLIProxyAPI",
                    "-config",
                    "/stage/config.yaml",
                ],
                stdout=subprocess.DEVNULL,
            )
            mapping = subprocess.check_output(
                ["docker", "port", name, "8317/tcp"], text=True
            ).strip()
            for _ in range(20):
                try:
                    assert request("/v1/models", base="http://" + mapping)[0] == 401
                    key = cfg["access"]["api-keys"][0]
                    assert (
                        request("/v1/models", key, base="http://" + mapping)[0] == 200
                    )
                    print("Isolated runtime validation passed.")
                    return
                except Exception:
                    time.sleep(1)
            raise RuntimeError("staging failed")
        finally:
            run(["docker", "rm", "-f", name], stdout=subprocess.DEVNULL)


command = sys.argv[1] if len(sys.argv) > 1 else "status"
try:
    if command == "validate":
        validate()
        staging(root / "state/runtime/config.yaml")
    elif command == "start":
        operation_lock = lock()
        validate()
        compose("up", "-d", "--wait")
        health()
        if (root / "state/endpoint.json").exists():
            compose("--profile", "portable-endpoint", "up", "-d", "tailnet")
        if (root / "state/public-endpoint-enabled").exists():
            run([str(root / "scripts/public-endpoint"), "start"])
    elif command == "stop":
        operation_lock = lock()
        compose(
            "--profile", "portable-endpoint", "--profile", "public-endpoint", "stop"
        )
    elif command == "restart":
        operation_lock = lock()
        validate()
        compose("restart", "proxy")
        wait()
    elif command == "health":
        health()
    elif command == "status":
        compose("--profile", "portable-endpoint", "--profile", "public-endpoint", "ps")
        health()
        for f in [
            "backup-success.json",
            "backup-failed",
            "backup-check-failed",
            "backup-operation-failed",
            "monitor-failed",
            "gc-failed",
            "gc-success.json",
        ]:
            p = root / "state/status" / f
            if p.exists():
                print(f, p.read_text().strip())
    elif command == "models":
        for m in health():
            print(m["id"])
    elif command == "logs":
        # Avoid emitting unreviewed upstream logs: redact every known credential, then token patterns.
        import re, yaml

        data = subprocess.check_output(
            ["docker", "compose", "logs", "--no-color", "--tail", "100", "proxy"],
            stderr=subprocess.STDOUT,
            text=True,
        )
        config = yaml.safe_load((root / "state/runtime/config.yaml").read_text())
        values = []

        def visit(obj):
            if isinstance(obj, dict):
                for k, v in obj.items():
                    if isinstance(v, str) and any(
                        x in k.lower() for x in ["key", "token", "secret", "password"]
                    ):
                        values.append(v)
                    visit(v)
            elif isinstance(obj, list):
                for v in obj:
                    visit(v)

        visit(config)
        values.extend(config["access"]["api-keys"])
        for f in (root / "state/secrets").iterdir():
            if f.is_file() and f.stat().st_size < 10000:
                try:
                    text = f.read_text().strip()
                    if f.suffix == ".json":
                        visit(json.loads(text))
                    else:
                        values.append(text)
                except Exception:
                    pass
        for f in (root / "state/runtime/auths").glob("*.json"):
            try:
                visit(json.loads(f.read_text()))
            except Exception:
                pass
        for value in sorted(set(values), key=len, reverse=True):
            if len(value) >= 6:
                data = data.replace(value, "[REDACTED]")
        data = re.sub(r'(?i)(bearer\s+)[^\s"\']+', r"\1[REDACTED]", data)
        data = re.sub(r"(?:sk-|eyJ)[A-Za-z0-9_.-]{15,}", "[REDACTED]", data)
        print(data)
    elif command == "apply":
        operation_lock = lock()
        candidate = pathlib.Path(sys.argv[2]).resolve()
        run([str(root / "scripts/validate-config"), str(candidate), "--require-fill-first"])
        staging(candidate)
        shutil.copy2(
            root / "state/runtime/config.yaml",
            root / "state/runtime/config.yaml.previous",
        )
        shutil.copyfile(candidate, root / "state/runtime/config.yaml.new")
        os.chmod(root / "state/runtime/config.yaml.new", 0o600)
        os.replace(
            root / "state/runtime/config.yaml.new", root / "state/runtime/config.yaml"
        )
        compose("restart", "proxy")
        wait()
    elif command in ["upgrade", "rollback"]:
        sys.exit(
            "Install a reviewed Git revision with bun run cliproxy install --revision REV; use --rollback for the recorded previous revision."
        )
    elif command == "add-account":
        operation_lock = lock()
        provider = sys.argv[2]
        flags = {
            "codex": "-codex-device-login",
            "claude": "-claude-login",
            "gemini": "-login",
            "antigravity": "-antigravity-login",
            "kimi": "-kimi-login",
            "xai": "-xai-login",
            "meta": "-meta-login",
            "devin": "-devin-login",
        }
        if provider == "gemini":
            sys.exit(
                "This release has no Gemini CLI login flag. Use official dashboard OAuth/API key configuration."
            )
        flag = flags[provider]
        compose(
            "exec",
            "proxy",
            "/CLIProxyAPI/CLIProxyAPI",
            "-config",
            "/state/config.yaml",
            flag,
            "-no-browser",
        )
    elif command == "inference":
        protocol, model = sys.argv[2:4]
        key = (root / "state/secrets/client-key").read_text().strip()
        if protocol == "responses":
            path = "/v1/responses"
            body = {
                "model": model,
                "input": "Reply only OK",
                "stream": True,
                "max_output_tokens": 32,
            }
        elif protocol == "messages":
            path = "/v1/messages"
            body = {
                "model": model,
                "messages": [{"role": "user", "content": "Reply only OK"}],
                "stream": True,
                "max_tokens": 16,
            }
        else:
            path = "/v1/chat/completions"
            body = {
                "model": model,
                "messages": [{"role": "user", "content": "Reply only OK"}],
                "stream": True,
                "max_tokens": 16,
            }
        code, data = request(path, key, body)
        assert code == 200 and b"data:" in data, (
            "Streaming inference failed (response suppressed)"
        )
        print(
            "Streaming transport returned SSE. Check protocol completion and tools with the actual client before production use."
        )
    elif command == "portable-login":
        compose("--profile", "portable-endpoint", "up", "-d", "tailnet")
        compose(
            "exec",
            "tailnet",
            "tailscale",
            "--socket=/tmp/tailscaled.sock",
            "up",
            "--hostname=cliproxy-fleet",
            "--advertise-tags=tag:ai-proxy",
            "--accept-dns=false",
        )
    elif command == "activate":
        health()
        compose(
            "exec",
            "tailnet",
            "tailscale",
            "--socket=/tmp/tailscaled.sock",
            "serve",
            "--service=svc:ai-proxy",
            "--https=443",
            "http://proxy:8317",
        )
        compose(
            "exec",
            "tailnet",
            "tailscale",
            "--socket=/tmp/tailscaled.sock",
            "serve",
            "status",
        )
    elif command == "drain":
        compose(
            "exec",
            "tailnet",
            "tailscale",
            "--socket=/tmp/tailscaled.sock",
            "serve",
            "drain",
            "svc:ai-proxy",
        )
    else:
        sys.exit(
            "Commands: start stop restart status health models logs validate apply FILE add-account PROVIDER inference PROTOCOL MODEL portable-login activate drain"
        )
except Exception:
    sys.exit(
        "Operation failed; secrets and upstream error responses suppressed. Check sanitized logs and service status."
    )
