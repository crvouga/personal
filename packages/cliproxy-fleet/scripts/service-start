#!/usr/bin/env bash
set -euo pipefail
cd /opt/cliproxy-fleet
./scripts/audit.py
./scripts/validate-config
/usr/bin/docker compose --project-directory /opt/cliproxy-fleet up -d --wait --force-recreate proxy
if [[ -f state/endpoint.json ]]; then
  /usr/bin/docker compose --project-directory /opt/cliproxy-fleet --profile portable-endpoint up -d tailnet
fi
if [[ -f state/public-endpoint-enabled ]]; then
  ./scripts/public-endpoint start
fi
