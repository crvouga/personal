{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal portable agent registry",
  "type": "object",
  "required": ["version", "defaults", "proxy", "nodes", "tools"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "defaults": {
      "type": "object"
    },
    "proxy": {
      "type": "object",
      "required": ["endpoint", "secret", "models"],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^https://"
        },
        "secret": {
          "type": "object",
          "required": ["mount", "project", "config", "key"],
          "additionalProperties": false,
          "properties": {
            "mount": {
              "type": "string",
              "minLength": 1
            },
            "project": {
              "type": "string",
              "minLength": 1
            },
            "config": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "models": {
          "type": "object"
        }
      }
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codex": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direct": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              },
              "proxy": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              }
            }
          },
          "claude": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direct": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              },
              "proxy": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              }
            }
          },
          "opencode": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direct": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              },
              "proxy": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              }
            }
          },
          "gemini": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direct": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              },
              "proxy": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              }
            }
          },
          "grok": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direct": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              },
              "proxy": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              }
            }
          },
          "antigravity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direct": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              },
              "proxy": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_./:+-]+$"
              }
            }
          }
        }
      }
    },
    "tools": {
      "type": "object"
    }
  }
}
