{
  "version": 1,
  "instances": {
    "personal_codex_proxy": {
      "driver": "codex",
      "displayName": "Personal CLI Proxy",
      "enabled": true,
      "config": {
        "binaryPath": "${workspace}/packages/workstation/agents/codex-proxy.ts",
        "homePath": "${agents}/${node}/codex/proxy"
      },
      "environment": [
        {
          "name": "WS_AGENT_NODE",
          "value": "${node}",
          "sensitive": false
        }
      ]
    },
    "personal_gateway_models": {
      "driver": "opencode",
      "displayName": "Shared provider accounts (OpenCode)",
      "enabled": true,
      "config": {
        "binaryPath": "${workspace}/packages/workstation/agents/opencode-proxy.ts"
      },
      "environment": [
        {
          "name": "WS_AGENT_NODE",
          "value": "${node}",
          "sensitive": false
        }
      ]
    }
  }
}
