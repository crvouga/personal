{
  "$schema": "https://v2-10-13.turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "6",
  "globalDependencies": [
    "bun.lock",
    "tsconfig.json",
    "package.json",
    "packages/infra/tofu/modules/inventory/inventory.tf.json",
    "packages/infra/tofu/modules/inventory/publish.yml.tftpl"
  ],
  "globalPassThroughEnv": ["CLOUDFLARE_*", "VAULT_*", "TURBO_*", "DEPLOY_*"],
  "tasks": {
    "setup": {
      "cache": false,
      "inputs": ["scripts/setup-*.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": [],
      "persistent": true,
      "cache": false
    },
    "tc": {
      "dependsOn": ["^tc"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "tsconfig.json",
        "../../tsconfig.strict.json"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^tc"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "eslint.config.js",
        "eslint.config.cjs"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test": {
      "dependsOn": ["^tc"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "passThroughEnv": ["PORTFOLIO_GITHUB_TOKEN"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "//#ci:format": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "outputLogs": "new-only"
    }
  }
}
